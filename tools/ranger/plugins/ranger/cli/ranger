#!/usr/bin/env python3
"""The `ranger` CLI entry point — a thin shim over ``ranger.cli.dispatch``.

Puts the plugin root (this file's ``../``) on ``sys.path`` so the sibling
``ranger`` package — and the plugin-root-level ``_bootstrap`` module its
dispatch lazy-imports — are importable whether run from the repo or an installed
plugin (``${CLAUDE_PLUGIN_ROOT}/cli/ranger``). All command logic lives in
``ranger.cli.*`` (one module per command group); keeping this shim minimal keeps
that logic unit-testable and the ``bin/ranger`` wrapper's exec target stable.
"""
from __future__ import annotations

import sys
from pathlib import Path

# cli/ranger → parent is cli/ → parent is plugins/ranger/ (the plugin root).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from ranger.cli import dispatch  # noqa: E402

if __name__ == "__main__":
    sys.exit(dispatch.main())
