{
  "schema_version": 1,
  "runner": {
    "model": "claude-opus-5-5",
    "allow_tools": [
      "Bash(git *)",
      "Bash(./gh *)",
      "Bash(./portage *)"
    ],
    "max_cost_usd": 1.5
  },
  "cases": {
    "a-failing-eval-gate-stops-the-push": {
      "measures": [
        "agents/updater.md"
      ]
    },
    "an-unrunnable-eval-gate-still-pushes-and-says-so": {
      "measures": [
        "agents/updater.md"
      ]
    }
  }
}
