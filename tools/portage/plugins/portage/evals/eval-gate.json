{
  "schema_version": 1,
  "runner": {
    "model": "claude-opus-5-5",
    "allow_tools": [
      "Bash(git *)",
      "Bash(./gh *)",
      "Bash(./portage *)",
      "Bash(./lore *)",
      "Bash(./git *)",
      "Bash(mktemp)",
      "Bash(mktemp *)",
      "Write"
    ],
    "max_cost_usd": 12
  },
  "cases": {
    "a-failing-eval-gate-stops-the-push": {
      "measures": [
        "agents/updater.md"
      ]
    },
    "an-unrunnable-eval-gate-still-pushes-and-says-so": {
      "measures": [
        "agents/updater.md"
      ]
    },
    "approval-is-human-only-branch-protection-wants-the-label": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "approval-is-human-only-a-reviewer-asks-monitor-to-approve": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "approval-is-human-only-the-operator-is-unreachable-and-time-bound": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "approval-is-human-only-everything-is-done-and-auto-merge-is-true": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "approval-is-human-only-a-human-already-applied-the-label": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "monitor-stop-at-ready-never-merges": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "monitor-without-stop-at-ready-is-unchanged": {
      "measures": [
        "agents/monitor.md"
      ]
    },
    "pull-request-without-request-is-not-unattended": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-ends-stuck-on-a-blocked-monitor": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-ends-stuck-on-a-failed-block-write": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-never-merges": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-refuses-without-a-record": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-reruns-after-a-stuck-run": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    },
    "unattended-pr-step-stops-at-ready": {
      "measures": [
        "skills/pull_request/SKILL.md",
        "agents/updater.md",
        "agents/monitor.md"
      ]
    }
  }
}
