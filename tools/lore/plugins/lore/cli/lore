#!/usr/bin/env python3
"""The `lore` CLI entry point — a thin shim over ``lore.cli.dispatch``.

Puts the plugin root (this file's ``../``) on ``sys.path`` so the sibling
``lore`` package — and the plugin-root-level ``_bootstrap`` module it and its
resolvers lazy-import — are importable whether run from the repo or an installed
plugin (``${CLAUDE_PLUGIN_ROOT}/cli/lore``). All command logic lives in
``lore.cli.*`` (one module per command group); keeping this shim minimal keeps
that logic unit-testable and the ``bin/lore`` wrapper's exec target stable.
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lore.cli import dispatch  # noqa: E402

if __name__ == "__main__":
    sys.exit(dispatch.main())
