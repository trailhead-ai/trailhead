    p_vault_delete.set_defaults(func=cmd_vault)

    p_vault_ls = p_vault_sub.add_parser("ls", help="List configured vaults")
    p_vault_ls.set_defaults(func=cmd_vault)

    p_vault_config = p_vault_sub.add_parser("config", help="Edit config.json in $EDITOR")
    p_vault_config.set_defaults(func=cmd_vault)

    # session subcommand: ``lore session candidate|referenced`` (Slice 6, S2).
    # A SEPARATE endpoint from ``lore record`` — it does NOT route through the
    # record write path (AC23, endpoint isolation). Registered with EXPLICIT
    # subcommand names; the action is required. The name is the exact string
    # ``session`` — it does NOT clash with the existing flat ``session-note``
    # command, because argparse prefers an exact subcommand match over an
    # abbreviation (council/Advocate; the no-prefix-abbrev-clash test pins this).
    p_session = sub.add_parser(
        "session",
        help="Log record candidates / references for a session (race-safe, AC20-23)",
    )
    p_session_sub = p_session.add_subparsers(dest="session_action", required=True)

    # ``lore session candidate --session-id ID --kind KIND --phase PHASE`` (AC20/AC21).
    p_session_candidate = p_session_sub.add_parser(
        "candidate",
