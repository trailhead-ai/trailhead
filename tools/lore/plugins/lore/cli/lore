def cmd_set_status(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    if not path.is_file():
        print(f"error: no such file: {path}", file=sys.stderr)
        return 1
    meta = frontmatter.parse_frontmatter(path)
    note_type = meta.get("type")
    if not status_validator.is_valid_status(note_type, args.value):
        permitted = status_validator.permitted_statuses(note_type)
        permitted_str = sorted(permitted) if permitted else "(unconstrained)"
        print(
            f"error: status {args.value!r} is not canonical for type {note_type!r}\n"
            f"  permitted: {permitted_str}",
            file=sys.stderr,
        )
        return 1
    if not frontmatter.set_status(path, args.value):
        print(f"error: {path} has no frontmatter block", file=sys.stderr)
        return 1
    return 0


# ---- sync -------------------------------------------------------------------

DEFAULT_SYNC_MSG = "lore: sync vault"


def _git(vault: Path, *args: str) -> tuple[int, str, str]:
    """Run a git command in the vault. Returns (returncode, stdout, stderr)."""
    try:
        result = subprocess.run(
            ["git", "-C", str(vault), *args],
            capture_output=True, text=True, timeout=60,
        )
        return result.returncode, (result.stdout or "").strip(), (result.stderr or "").strip()
    except Exception as e:
        return 1, "", f"{type(e).__name__}: {e}"


def _vault_is_git_toplevel(vault: Path) -> bool:
    rc, out, _ = _git(vault, "rev-parse", "--show-toplevel")
    if rc != 0 or not out:
        return False
    try:
        return Path(out).resolve() == vault.resolve()
    except Exception:
        return False


def cmd_sync(args: argparse.Namespace) -> int:
    vault = Path(vault_mod.resolve_vault())

    if not vault.exists():
        print(f"error: vault not found: {vault}", file=sys.stderr)
        return 1

    if not _vault_is_git_toplevel(vault):
        print(
            f"error: vault is not its own git toplevel: {vault}\n"
            "  (vault may be a subdirectory of a larger repo, or not a git repo)\n"
            "  Aborting — refusing to operate on the wrong tree.",
            file=sys.stderr,
        )
        return 1

    message = getattr(args, "message", None) or DEFAULT_SYNC_MSG

    # Stage everything.
    rc, _, stderr = _git(vault, "add", "-A")
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    # Check if there's anything to commit.
    rc, status_out, _ = _git(vault, "status", "--porcelain")
    if rc != 0 or not status_out.strip():
        print("Nothing to commit — vault is clean.")
        return 0

    # Commit — never pass -S or --no-gpg-sign; honor adopter's commit.gpgsign.
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    # Push to origin if it exists.
    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0

    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print(
            f"notice: committed locally; push failed — re-run `lore sync` when online",
            file=sys.stderr,
        )
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


# ---- finish -----------------------------------------------------------------

def _get_current_status(note: Path) -> str | None:
    """Return the current status value from a note's frontmatter, or None."""
    try:
        fm = frontmatter.parse_frontmatter(note)
        status = fm.get("status")
        return str(status) if status is not None else None
    except Exception:
        return None


def _commit_and_push_session_note(vault: Path, session_note: Path, worktree_name: str, verb: str) -> int:
    """Stage, commit, and push a single session note. Returns exit code."""
    if not vault.exists():
        print(f"notice: vault not found: {vault} — skipping commit.", file=sys.stderr)
        return 0

    if not _vault_is_git_toplevel(vault):
        print(
            "notice: vault is not its own git toplevel — skipping commit.",
            file=sys.stderr,
        )
        return 0

    rc, _, stderr = _git(vault, "add", "--", str(session_note))
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    rc, status_out, _ = _git(vault, "status", "--porcelain")
    if rc != 0 or not status_out.strip():
        print("Nothing to commit — vault is clean.")
        return 0

    message = f"session: {verb} {worktree_name}"
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0

    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print(
            "notice: committed locally; push failed — re-run `lore sync` when online",
            file=sys.stderr,
        )
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


def _harvest_expand(vault: Path, session_note: Path) -> harvest_mod.ExpansionResult | None:
    """Expand harvest-pending + the session note's candidates block to disk.

    Writes the expanded notes (idempotent by harvest-hash) but does NOT touch
    the pending file or git — the caller folds the pending rewrite into the
    same atomic commit. Returns None when there is no pending file to read.
    """
    pending = vault / "harvest-pending.md"
    pending_text = pending.read_text(encoding="utf-8") if pending.exists() else ""
    try:
        session_text = session_note.read_text(encoding="utf-8")
    except Exception:
        session_text = ""

    project = vault_mod.resolve_project()
    return harvest_mod.expand(
        vault=vault,
        pending_text=pending_text,
        session_text=session_text,
        templates_dir=TEMPLATES_DIR,
        today=_today(),
        project=project,
    )


def _report_harvest(result: harvest_mod.ExpansionResult) -> None:
    for path in result.written:
        print(f"Harvested: {path}")
    for warning in result.warnings:
        print(warning, file=sys.stderr)
    if result.gotchas:
        print("Surfaced gotchas (not expanded — patch via /lore:area):")
        for g in result.gotchas:
            print(f"  - gotcha: {g.body}")


def _finish_commit(
    vault: Path,
    session_note: Path,
    pending: Path,
    new_notes: list[Path],
    worktree_name: str,
) -> int:
    """Stage explicit paths + commit the session note, new notes, and pending
    in a SINGLE commit. Never `git add -A`. On commit failure the notes remain
    on disk and the (unrewritten) pending still holds the entries, so a re-run
    re-expands cleanly (dedup-by-hash). Returns exit code."""
    if not vault.exists() or not _vault_is_git_toplevel(vault):
        print("notice: vault is not its own git toplevel — skipping commit.", file=sys.stderr)
        return 0

    paths = [str(session_note)] + [str(p) for p in new_notes]
    if pending.exists():
        paths.append(str(pending))

    rc, _, stderr = _git(vault, "add", "--", *paths)
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    rc, _, _ = _git(vault, "diff", "--cached", "--quiet")
    if rc == 0:
        print("Nothing to commit — index is clean.")
        return 0

    message = f"session: finalize {worktree_name}"
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0
    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print("notice: committed locally; push failed — re-run `lore sync` when online", file=sys.stderr)
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


def cmd_finish(args: argparse.Namespace) -> int:
    """Finalize the active session note for the current worktree.

    Resolves the session note via `vault.resolve_session_note()` — exact
    session-id match first (so the *current* session's note is finalized even
    when several exist for this worktree), then a worktree-name fallback. Sets
    `status: complete` and `ended:` (atomic write), then expands the in-scope
    harvest-pending entries + the note's `## Harvest candidates` block into full
    vault notes and commits the session note + new notes + the rewritten pending
    in ONE commit (explicit paths only). `gotcha` entries are surfaced (not
    expanded) and left in pending; malformed lines are retained + warned. On
    commit failure the notes are on disk and pending is restored, so a re-run
    re-expands idempotently. If no active session note is found, prints a notice
    and exits 0.
    """
    vault = Path(vault_mod.resolve_vault())
    session_id = _session_id_from_args_or_env(args)
    worktree_name = args.worktree or vault_mod.detect_worktree_name()

    session_note = vault_mod.resolve_session_note(
        vault, session_id=session_id, worktree_name=worktree_name
    )
    if session_note is None:
        print(
            f"notice: no active session note found for worktree {worktree_name!r} — "
            "nothing to finalize.",
        )
        return 0

    now_iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    ok = sessions_mod.finalize_note(session_note, now_iso)
    if ok:
        print(f"Finalized: {session_note.name}")
    else:
        # Already terminal. Still attempt harvest expansion: a prior finish may
        # have finalized the note but failed to commit the harvest (e.g. a
        # failed commit), leaving pending entries to recover. If there is no
        # pending work, the expansion + commit are both no-ops.
        current_status = _get_current_status(session_note)
        label = current_status if current_status else "terminal"
        print(f"notice: already {label} — checking for unharvested pending entries.")

    # Expand harvest entries to disk FIRST (notes survive a failed commit).
    result = _harvest_expand(vault, session_note)
    if result is not None:
        _report_harvest(result)

    if not _vault_is_git_toplevel(vault):
        # Non-git vault: status is set, notes are written, but no commit.
        print("notice: vault is not its own git toplevel — skipping commit.", file=sys.stderr)
        return 0

    # Rewrite pending to drop consumed entries — but ONLY as part of the same
    # commit. We write it to disk here, then stage+commit; if the commit fails,
    # the consumed entries were already cleared from the working tree, so we
    # restore the file on failure to keep the entries recoverable.
    pending = vault / "harvest-pending.md"
    pending_before = pending.read_text(encoding="utf-8") if pending.exists() else None
    if result is not None and result.consumed_hashes and pending_before is not None:
        pending.write_text(
            harvest_mod.rewrite_pending(pending_before, result.consumed_hashes),
            encoding="utf-8",
        )

    new_notes = result.written if result is not None else []
    rc = _finish_commit(vault, session_note, pending, new_notes, worktree_name)
    if rc != 0 and pending_before is not None:
        # Commit failed: restore pending so no entry is lost; notes stay on disk
        # and a clean re-run re-expands idempotently (dedup-by-hash).
        pending.write_text(pending_before, encoding="utf-8")
    return rc


# ---- handoff ----------------------------------------------------------------

def cmd_handoff(args: argparse.Namespace) -> int:
    """Shelve the active session note for the current worktree.

    Mirrors `lore finish` but writes ``status: shelved`` instead of
    ``status: complete``.  Idempotent: when the note is already in a
    terminal status, prints a notice and returns 0 without committing.

    When ``--pickup-hints-file`` is given, the file's content is written
    under a ``## Pickup hints`` section of the session note BEFORE shelving
    (atomic: hints + shelve happen together, never hints-only).  If the note
    is already terminal, the idempotency guard fires BEFORE writing hints so
    an already-shelved note is never double-written.

    Resolves the note via `vault.resolve_session_note()` (session-id first,
    worktree-name fallback) so the *current* session's note is shelved.
    """
    vault = Path(vault_mod.resolve_vault())
    session_id = _session_id_from_args_or_env(args)
    worktree_name = args.worktree or vault_mod.detect_worktree_name()

    session_note = vault_mod.resolve_session_note(
        vault, session_id=session_id, worktree_name=worktree_name
    )
    if session_note is None:
        print(
            f"notice: no active session note found for worktree {worktree_name!r} — "
            "nothing to shelve.",
        )
        return 0

    hints_file: Path | None = getattr(args, "pickup_hints_file", None)
    if hints_file is not None:
        hints_file = Path(hints_file)

    now_iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    ok = sessions_mod.finalize_note(session_note, now_iso, status="shelved")
    if not ok:
        current_status = _get_current_status(session_note)
        label = current_status if current_status else "terminal"
        print(f"notice: already {label} — nothing to do.")
        return 0

    if hints_file is not None:
        try:
            hints_text = hints_file.read_text()
        except Exception as exc:
            print(f"error: cannot read --pickup-hints-file {hints_file}: {exc}", file=sys.stderr)
            return 1
        frontmatter.patch_section(session_note, "Pickup hints", hints_text)

    print(f"Shelved: {session_note.name}")
    return _commit_and_push_session_note(vault, session_note, worktree_name, "shelve")


# ---- shelved / resume (pickup surface) --------------------------------------

def _pickup_hints_fragment(note: Path) -> str:
    """Return a one-line context fragment for a shelved note.

    Prefers the first non-empty line under a ``## Pickup hints`` heading; falls
    back to the note's ``# `` title line, then the filename stem. Truncated so a
    list stays scannable. Never raises.
    """
    try:
        text = note.read_text()
    except Exception:
        return note.stem

    lines = text.splitlines()
    in_hints = False
    for line in lines:
        if line.strip().lower().startswith("## pickup hints"):
            in_hints = True
            continue
        if in_hints:
            if line.strip().startswith("## "):
                break
            if line.strip():
                return line.strip()[:80]

    for line in lines:
        if line.startswith("# "):
            return line[2:].strip()[:80]
    return note.stem


def _note_timestamp(note: Path) -> str:
    """Return the note's ended:/started: frontmatter timestamp, or '(no timestamp)'."""
    try:
        fm = frontmatter.parse_frontmatter(note)
    except Exception:
        return "(no timestamp)"
    for key in ("ended", "started"):
        val = fm.get(key)
        if isinstance(val, str) and val.strip():
            return val.strip()
    return "(no timestamp)"


def cmd_shelved(args: argparse.Namespace) -> int:
    """List shelved/handoff session notes, most-recent-first.

    Prints each note's path + frontmatter timestamp + a short context fragment
    (first Pickup-hints line, else the title) so an interactive picker is
    usable. Optional ``--slug`` narrows to one worktree slug.
    """
    vault = Path(vault_mod.resolve_vault())
    slug = getattr(args, "slug", None)
    notes = sessions_mod.find_shelved_notes(vault, slug=slug)

    if not notes:
        if slug:
            print(f"Nothing shelved for slug {slug!r}.")
        else:
            print("Nothing shelved — no notes to resume.")
        return 0

    for note in notes:
        ts = _note_timestamp(note)
        fragment = _pickup_hints_fragment(note)
        print(f"{note}")
        print(f"  {ts} — {fragment}")
    return 0


def _resolve_resume_target(vault: Path, target: str) -> Path | None:
    """Resolve a resume target — an explicit file path OR a worktree slug.

    A path that exists is used directly. Otherwise *target* is treated as a
    slug and matched against shelved/handoff notes (most-recent-first). Returns
    None when nothing matches.
    """
    as_path = Path(target).expanduser()
    if as_path.is_file():
        return as_path
    matches = sessions_mod.find_shelved_notes(vault, slug=target)
    return matches[0] if matches else None


def _resolve_implicit_resume_target(vault: Path, args: argparse.Namespace) -> Path | None:
    """Resolve the resume target when no positional was given: exact
    session-id match (any status — `resume_note` rejects non-shelved notes),
    else the most-recent shelved note for the worktree (override or detected)."""
    session_id = _session_id_from_args_or_env(args)
    if session_id:
        return vault_mod.find_session_note_by_session_id(vault, session_id)
    worktree_name = args.worktree or vault_mod.detect_worktree_name()
    matches = sessions_mod.find_shelved_notes(vault, slug=worktree_name)
    return matches[0] if matches else None


def cmd_resume(args: argparse.Namespace) -> int:
    """Flip a shelved/handoff session note back to active.

    With a positional target, accepts an explicit note path OR a worktree slug.
    With no target, resolves the current session's shelved note (``--session-id``
    → ``--worktree`` → auto-detected worktree). On a non-resumable note
    (active/complete/finalized) prints a clear no-op message and returns 0.
    A target that resolves to nothing is an error (non-zero).
    """
    vault = Path(vault_mod.resolve_vault())
    if args.target:
        note = _resolve_resume_target(vault, args.target)
    else:
        note = _resolve_implicit_resume_target(vault, args)
    if note is None:
        label = args.target or args.worktree or _session_id_from_args_or_env(args) or "current worktree"
        print(f"error: no shelved note found for {label!r}", file=sys.stderr)
        return 1

    if sessions_mod.resume_note(note):
        print(f"Resumed: {note.name} (status: active)")
        return 0

    current = _get_current_status(note) or "unknown"
    print(f"notice: {note.name} is not shelved (status: {current}) — nothing to resume.")
    return 0


# ---- stats ------------------------------------------------------------------

def _count(directory: Path, predicate, recursive: bool = False) -> int:
    if not directory.is_dir():
        return 0
    return sum(
        1
        for p in vault_mod.iter_note_paths(directory, recursive=recursive)
        if predicate(frontmatter.parse_frontmatter(p))
    )


def cmd_stats(args: argparse.Namespace) -> int:
    vault = Path(vault_mod.resolve_vault())
    areas = _count(vault / "areas", lambda fm: True)
    open_deferred = _count(
        vault / "deferred",
        lambda fm: fm.get("status") in ("open", "resurfaced"),
        recursive=True,
    )
    active_lessons = _count(
        vault / "lessons",
        lambda fm: fm.get("status", "active") == "active",
        recursive=True,
    )
    dead_ends = _count(
        vault / "dead-ends", lambda fm: fm.get("type") == "dead-end", recursive=True
    )
    sessions = _count(vault / "sessions", lambda fm: fm.get("type") == "session", recursive=True)

    print(f"vault: {vault}")
    print(f"areas:          {areas}")
    print(f"open deferred:  {open_deferred}")
    print(f"active lessons: {active_lessons}")
    print(f"dead-ends:      {dead_ends}")
    print(f"sessions:       {sessions}")
    return 0


# ---- session-note -----------------------------------------------------------

def _session_id_from_args_or_env(args: argparse.Namespace) -> str:
    """Resolve the session id: explicit ``--session-id`` flag wins, else the
    Claude Code env var (``CLAUDE_CODE_SESSION_ID``, with the legacy
    ``CLAUDE_SESSION_ID`` name as a fallback)."""
    sid = getattr(args, "session_id", None)
    if sid:
        return sid
    return (
        os.environ.get("CLAUDE_CODE_SESSION_ID")
        or os.environ.get("CLAUDE_SESSION_ID")
        or ""
    )


def cmd_session_note(args: argparse.Namespace) -> int:
    """Print the vault-relative path of the session note for this session.

    Resolution order (see `vault.resolve_session_note`): exact session-id
    frontmatter match (cwd-independent) → worktree-name fallback (newest by
    filename timestamp). On a miss, prints a diagnostic listing what was tried
    to stderr and exits 1, so callers don't invent exploratory `ls`/`git`
    commands to guess.
    """
    vault = Path(vault_mod.resolve_vault())
    session_id = _session_id_from_args_or_env(args)
    worktree_name = args.worktree or vault_mod.detect_worktree_name()

    note = vault_mod.resolve_session_note(
        vault, session_id=session_id, worktree_name=worktree_name
    )
    if note is not None:
        try:
            print(note.relative_to(vault))
        except ValueError:
            print(note)
        return 0

    print(
        "lore session-note: no session note resolved.\n"
        f"  session_id: {session_id or '<unset>'}\n"
        f"  worktree:   {worktree_name or '<unknown>'}\n"
        f"  searched:   {vault / 'sessions'}",
        file=sys.stderr,
    )
    return 1


# ---- recall -----------------------------------------------------------------

def cmd_recall(args: argparse.Namespace) -> int:
    """Print the recall banner for the requested areas to stdout.

    Exit code is always 0 — recall must never fail a session (D-1).
    A vault-resolution / infra error prints a one-line stderr signal and
    falls back to the zero-match banner on stdout.

    --json emits the structured RecallResult for programmatic callers
    (e.g. the librarian agent). JSON items carry source/layer (D-7).
    """
    import json as _json

    tty = sys.stdout.isatty()

    # Parse area names from the comma-separated --areas argument.
    raw_areas = (getattr(args, "areas", None) or "").strip()
    area_names = [a.strip() for a in raw_areas.split(",") if a.strip()]

    # Resolve vault: --vault overrides $LORE_VAULT.
    vault_override = getattr(args, "vault", None)
    try:
        if vault_override:
            vault = Path(vault_override).expanduser().resolve()
        else:
            vault = Path(vault_mod.resolve_vault())
        if not vault.exists():
            raise FileNotFoundError(vault)
    except Exception as exc:
        print(
            f"lore recall: could not resolve vault ({exc})",
            file=sys.stderr,
        )
        # Degrade to zero-match banner so the caller gets *something* on stdout.
        empty_result = recall_mod.RecallResult(areas=[], matched_area_names=[])
        print(recall_mod.render_recall_banner(empty_result, tty=tty))
        return 0

    # Resolve layers: when --vault is NOT set, compose all declared layers
    # (personal + shared). When --vault IS set, skip layer resolution — the
    # override is a deliberate "use exactly this vault" escape (D-3).
    all_layers = None
    if not vault_override:
        try:
            all_layers = layers_mod.resolve_layers(
                cwd=Path.cwd(),
                groups_dir=_resolve_groups_dir(),
            )
        except Exception:
            all_layers = None  # degrade to single-vault; never fail a session

    try:
        result = recall_mod.recall_areas(vault, area_names, layers=all_layers)
    except Exception as exc:
        print(
            f"lore recall: recall failed ({exc})",
            file=sys.stderr,
        )
        empty_result = recall_mod.RecallResult(areas=[], matched_area_names=[])
        print(recall_mod.render_recall_banner(empty_result, tty=tty))
        return 0

    if getattr(args, "json", False):
        def _item_to_dict(item):
            return {
                "type": item.type,
                "title": item.title,
                "path": str(item.path),
                "one_liner": item.one_liner,
                "source": item.source,
                "layer": item.layer,
                "trusted": item.trusted,
            }
        payload = {
            "areas": result.areas,
            "items": [_item_to_dict(it) for it in result.items],
            "count": result.count,
            "cross_cutting_total": result.cross_cutting_total,
        }
        print(_json.dumps(payload, indent=2))
    else:
        print(recall_mod.render_recall_banner(result, tty=tty))

    return 0


def cmd_areas(args: argparse.Namespace) -> int:
    """Print the full area menu (names, one-liners, keywords) to stdout.

    Exit code is always 0 — must never fail a session (D-1).
    Prints a one-line stderr signal and a degraded stdout "no areas" line when
    the resolved vault path does not exist on disk, or when build_area_map
    raises. Empty or absent areas/ dir prints a friendly "no areas" line.
    """
    _NO_AREAS_LINE = "No areas defined yet."

    try:
        vault = Path(vault_mod.resolve_vault())
        if not vault.exists():
            raise FileNotFoundError(vault)
    except Exception as exc:
        print(f"lore areas: could not resolve vault ({exc})", file=sys.stderr)
        print(_NO_AREAS_LINE)
        return 0

    try:
        entries = recall_mod.build_area_map(vault)
    except Exception as exc:
        print(f"lore areas: could not build area map ({exc})", file=sys.stderr)
        print(_NO_AREAS_LINE)
        return 0

    menu = recall_mod.render_area_menu(entries)
    if menu:
        print(menu)
    else:
        print(_NO_AREAS_LINE)
    return 0


# ---- reindex ----------------------------------------------------------------

def cmd_reindex(args: argparse.Namespace) -> int:
    """Rebuild the derived SQLite index from the vault directory tree.

    Drops and repopulates the ``records`` table by scanning the resolved
    vault for ``<kind>/<name>.json`` + ``<kind>/<name>.md`` pairs.  Prints
    the number of indexed rows to **stdout** on success; errors go to
    **stderr**.  Exits 0.

    Text-wins / index-derived posture (AC-TX2): the index is always
    rebuildable from the git-tracked text files.
    """
    vault_root = (
        Path(args.vault).expanduser().resolve()
        if getattr(args, "vault", None)
        else Path(vault_mod.resolve_vault())
    )
    try:
        conn = index_store_mod.open_index()
        try:
            count = index_store_mod.rebuild([str(vault_root)], conn)
            conn.commit()
        finally:
            conn.close()
    except Exception as exc:
        print(f"error: reindex failed: {exc}", file=sys.stderr)
        return 1
    print(count)
    return 0


# ---- record -----------------------------------------------------------------

# Provenance keys that the CLI auto-sets on every write — the operator must
# never be able to override these via --set / --unset (AC-PROV1). Derived from
# the record_model ``auto_set`` attribute so it stays in sync with S1's schema.
_PROVENANCE_KEYS: frozenset[str] = record_model_mod.auto_set_keys("v1")


def _list_typed_keys() -> frozenset[str]:
    """Return the set of sidecar keys whose type_tag is ``list[str]`` (v1).

    Used by the --set/--unset matrix (AC15-AC18) to distinguish scalar fields
    from list fields without hardcoding a key list.  Derived from S1's
    FIELDS_V1 so it stays in sync with the model.
    """
    return frozenset(
        key
        for key, spec in record_model_mod.FIELDS_V1.items()
        if spec.type_tag == "list[str]"
    )


def _apply_set_unset(
    sidecar: dict,
    set_pairs: list[str],
    unset_pairs: list[str],
) -> tuple[dict, list[str]]:
    """Apply --set K=V / --unset K to *sidecar*; return (updated, errors).

    Implements the full AC15–AC18 + AC-PROV1 matrix:
      - AC-PROV1: --set / --unset on a provenance key → error, nothing applied.
      - AC15: --set K="" on a scalar key ≡ --unset K (clears the key).
      - AC16: --unset K=VALUE removes one item from a list-valued key.
      - AC17: --set K="" on a list-valued key → hard error naming correct forms.
      - AC18: --unset K (no =VALUE) clears the whole list / scalar key.

    Returns the (possibly mutated copy of) sidecar and a list of error strings
    (non-empty means nothing should be written).
    """
    list_keys = _list_typed_keys()
    errors: list[str] = []
    result = dict(sidecar)

    for pair in set_pairs:
        if "=" in pair:
            key, value = pair.split("=", 1)
        else:
            key, value = pair, ""

        if key in _PROVENANCE_KEYS:
            errors.append(
                f"error: --set {key!r} is a provenance field; "
                f"it is auto-set by lore and cannot be changed (AC-PROV1)"
            )
            continue

        if key in list_keys:
            if value == "":
                # AC17: --set K="" on a list field is a hard error.
                errors.append(
                    f"error: --set {key!r}=\"\" is not valid for a list field; "
                    f"to remove one item use --unset {key}=VALUE; "
                    f"to clear the whole list use --unset {key}"
                )
                continue
            # Append the value to the list (create if missing).
            current = result.get(key, [])
            if not isinstance(current, list):
                current = []
            result[key] = current + [value]
        else:
            # Scalar field.
            if value == "":
                # AC15: --set K="" ≡ --unset K on a scalar.
                result.pop(key, None)
            else:
                result[key] = value

    for pair in unset_pairs:
        if "=" in pair:
            key, value = pair.split("=", 1)
        else:
            key, value = pair, None

        if key in _PROVENANCE_KEYS:
            errors.append(
                f"error: --unset {key!r} is a provenance field; "
                f"it is auto-set by lore and cannot be changed (AC-PROV1)"
            )
            continue

        if value is not None:
            # AC16: --unset K=VALUE removes one item from a list. The K=VALUE
            # form is only meaningful for list fields; on a scalar key it would
            # be a silent no-op (an agent footgun), so reject it explicitly.
            if key not in list_keys:
                errors.append(
                    f"error: --unset {key}=VALUE is only valid for list fields; "
                    f"to clear a scalar field use --unset {key}"
                )
                continue
            current = result.get(key, [])
            if isinstance(current, list) and value in current:
                current = [v for v in current if v != value]
                result[key] = current
            # Removing a value not present in the list is a tolerated no-op.
        else:
            # AC18: --unset K (no value) clears the scalar or whole list.
            result.pop(key, None)

    return result, errors


def cmd_record(args: argparse.Namespace) -> int:
    """Dispatch ``lore record <action>`` — create (Slice 3) / update (Slice 4) (S2).

    Thin shell over ``record_store`` (Slice 2). Routes to the create or update
    handler by ``record_action``; both are argv→library adapters with no
    validation or I/O logic of their own.
    """
    action = getattr(args, "record_action", None)
    if action == "create":
        return _cmd_record_create(args)
    if action == "update":
        return _cmd_record_update(args)
    print(
        f"lore record: unknown action {action!r}. "
        f"Use 'lore record create' or 'lore record update'.",
        file=sys.stderr,
    )
    return 1


def _cmd_record_create(args: argparse.Namespace) -> int:
    """``lore record create`` (Slice 3, S2) — thin shell over ``record_store``.

    Builds the sidecar dict, reads the body from stdin (empty string when stdin is
    not piped), calls ``place_record`` + ``validate_and_write``, and prints the
    vault-relative RECORD_ID on stdout.

    Body is read verbatim from stdin — a leading ``---`` block is **never**
    parsed as frontmatter (AC-TX3); it is stored as body text.

    Routing flags (--repo / --product / --suite / --team) are passed to
    ``place_record`` as ``scope`` for the S4 multi-vault hook.  The
    ``--team`` routing flag is distinct from ``--set team=X`` (AC-ROUTE1):
    the routing flag influences vault selection (S4); ``--set team=X`` writes
    the ``team`` metadata field in the sidecar.
    """
    # --kind is required (AC2).
    kind = getattr(args, "kind", None)
    if not kind:
        print("error: --kind is required", file=sys.stderr)
        return 1

    # --title is required (operator-required by the record model).
    title = getattr(args, "title", None)
    if not title:
        print("error: --title is required", file=sys.stderr)
        return 1

    # Build the scope string from routing flags (AC5, AC-ROUTE1).
    # These are routing hints passed to place_record; they do NOT go into
    # the sidecar (that is --set team=X / --set repo=X, which is separate).
    scope_parts: list[str] = []
    for flag in ("repo", "product", "suite", "team"):
        val = getattr(args, flag, None)
        if val:
            scope_parts.append(f"{flag}:{val}")
    scope = ",".join(scope_parts) if scope_parts else None

    # Seed the sidecar with the required operator fields.
    sidecar: dict = {
        "kind": kind,
        "title": title,
        "keywords": [],
    }

    # Apply --set / --unset mutations (AC15-AC18, AC-PROV1).
    set_pairs: list[str] = list(getattr(args, "set_pairs", None) or [])
    unset_pairs: list[str] = list(getattr(args, "unset_pairs", None) or [])

    sidecar, set_errors = _apply_set_unset(sidecar, set_pairs, unset_pairs)
    if set_errors:
        for msg in set_errors:
            print(msg, file=sys.stderr)
        return 1

    # Body from stdin (AC1). No stdin → empty body.  The leading ``---``
    # check is intentionally absent — we read verbatim (AC-TX3).
    if sys.stdin.isatty():
        body = ""
    else:
        body = sys.stdin.read()

    # Resolve vault.
    vault_root = Path(vault_mod.resolve_vault())

    try:
        conn = index_store_mod.open_index()
        try:
            location = record_store_mod.place_record(
                name=title,
                kind=kind,
                scope=scope,
                vault_root=str(vault_root),
            )
            record_id = record_store_mod.validate_and_write(
                location=location,
                sidecar=sidecar,
                body=body,
                conn=conn,
            )
            conn.commit()
        finally:
            conn.close()
    except record_store_mod.RecordValidationError as exc:
        for msg in exc.errors:
            print(f"error: {msg}", file=sys.stderr)
        return 1
    except record_store_mod.ProvenanceError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"error: record create failed: {exc}", file=sys.stderr)
        return 1

    # AC4: print the vault-relative RECORD_ID on stdout.
    print(record_id)
    return 0


def _cmd_record_update(args: argparse.Namespace) -> int:
    """``lore record update RECORD_ID`` (Slice 4, S2) — thin shell over ``record_store``.

    Body sources (mutually exclusive on stdin):
      - **Full-body** (default, piped stdin): stdin replaces the whole body (AC9).
      - **``--diff``**: stdin is a unified diff applied to the existing body via
        ``record_store.apply_unified_diff`` (KU2). The post-hunk body flows through
        ``validate_and_write`` → ``neutralize_fences`` before the atomic rename, so
        a hunk injecting an ``<external-memory>`` token cannot land a live fence
        (council/Security — the diff path is not a neutralization bypass). Any hunk
        failing → non-zero, record byte-for-byte unmodified, no index update
        (AC-DIFF1); rejected hunks print to stderr one-line-per-hunk for agent retry.
      - **Metadata-only** (no stdin): the body is unchanged and only ``--set`` /
        ``--unset`` sidecar params apply (AC10/AC11). A ``note: no stdin — body
        unchanged, metadata-only update`` is printed to **stderr** (exit stays 0)
        so an agent that *forgot* to pipe a body can detect the mode
        (council/Advocate).

    ``updated-at``/``updated-by`` are re-stamped every update; ``created-*`` are
    preserved (``validate_and_write`` recovers them from the on-disk sidecar).

    ``--move-to VAULT`` relocates the record to a different vault root via
    ``record_store.move_record`` (AC12): the record physically moves, the new ID is
    returned. In S2 the move *primitive* is exercised by injecting a second vault
    root; the scope→different-vault routing *trigger* is S4's resolution.

    Invalid/nonexistent RECORD_ID → non-zero (AC8).
    """
    import json

    record_id = getattr(args, "record_id", None)
    if not record_id or "/" not in record_id:
        print(
            f"error: invalid RECORD_ID {record_id!r}; expected '<kind>/<name>'",
            file=sys.stderr,
        )
        return 1

    use_diff = bool(getattr(args, "diff", False))
    move_to = getattr(args, "move_to", None)

    # stdin detection: a TTY is never "piped"; otherwise read what's there. An
    # empty read (no pipe / /dev/null / closed stdin) is the metadata-only signal
    # (AC10) — distinct from a non-empty body replace (AC9). An intentional
    # empty-body replace is degenerate and out of scope; clear the body via a
    # ``--diff`` deleting every line instead.
    if sys.stdin.isatty():
        stdin_text = ""
    else:
        stdin_text = sys.stdin.read()
    has_stdin = stdin_text != ""

    vault_root = str(vault_mod.resolve_vault())

    try:
        conn = index_store_mod.open_index()
        try:
            # Resolve the existing record in place (AC8 → RecordNotFoundError).
            location = record_store_mod.locate_record(record_id, vault_root=vault_root)

            # Load the existing sidecar so --set/--unset mutate the live record.
            existing_sidecar: dict = {}
            if location.sidecar_path.exists():
                try:
                    existing_sidecar = json.loads(
                        location.sidecar_path.read_text(encoding="utf-8")
                    )
                except (OSError, ValueError):
                    existing_sidecar = {}
            if not isinstance(existing_sidecar, dict):
                existing_sidecar = {}

            existing_body = (
                location.body_path.read_text(encoding="utf-8")
                if location.body_path.exists()
                else ""
            )

            # --- resolve the new body -----------------------------------------
            if use_diff:
                # stdin is a unified diff applied to the existing body (KU2).
                try:
                    new_body, _ = record_store_mod.apply_unified_diff(
                        existing_body, stdin_text
                    )
                except record_store_mod.DiffRejectError as exc:
                    # Atomic reject (AC-DIFF1): body byte-for-byte unchanged, no
                    # index update. Parseable one-line-per-hunk stderr for retry.
                    for header, reason in exc.rejected:
                        print(f"rejected hunk {header}: {reason}", file=sys.stderr)
                    return 1
                except record_store_mod.DiffFormatError as exc:
                    print(f"error: unparseable diff: {exc}", file=sys.stderr)
                    return 1
            elif has_stdin:
                # Full-body replace (AC9).
                new_body = stdin_text
            else:
                # Metadata-only (AC10/AC11): body unchanged. Emit the notice to
                # stderr (council/Advocate) — exit stays 0.
                new_body = existing_body
                print(
                    "note: no stdin — body unchanged, metadata-only update",
                    file=sys.stderr,
                )

            # --- apply --set / --unset to the sidecar -------------------------
            set_pairs: list[str] = list(getattr(args, "set_pairs", None) or [])
            unset_pairs: list[str] = list(getattr(args, "unset_pairs", None) or [])
            sidecar, set_errors = _apply_set_unset(
                existing_sidecar, set_pairs, unset_pairs
            )
            if set_errors:
                for msg in set_errors:
                    print(msg, file=sys.stderr)
                return 1

            # --- write in place (re-stamps updated-*, preserves created-*) -----
            new_id = record_store_mod.validate_and_write(
                location=location,
                sidecar=sidecar,
                body=new_body,
                conn=conn,
            )

            # --- vault-move (AC12): relocate to a different vault root ---------
            if move_to:
                dest_root = str(Path(move_to).expanduser())
                if dest_root != location.vault_root:
                    dest_location = record_store_mod.RecordLocation(
                        vault_root=dest_root,
                        kind=location.kind,
                        name=location.name,
                        record_id=location.record_id,
                        body_path=Path(dest_root) / location.kind / f"{location.name}.md",
                        sidecar_path=Path(dest_root) / location.kind / f"{location.name}.json",
                    )
                    new_id = record_store_mod.move_record(
                        old_id=location.record_id,
                        new_location=dest_location,
                        conn=conn,
                        old_vault_root=location.vault_root,
                    )

            conn.commit()
        finally:
            conn.close()
    except record_store_mod.RecordNotFoundError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except record_store_mod.RecordValidationError as exc:
        for msg in exc.errors:
            print(f"error: {msg}", file=sys.stderr)
        return 1
    except record_store_mod.ProvenanceError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"error: record update failed: {exc}", file=sys.stderr)
        return 1

    print(new_id)
    return 0


# ---- unknown-command dispatch hint ------------------------------------------

# Table mapping removed/renamed commands to their replacements (AC-DISP1).
# The ``recall→search`` mapping is dormant in S2 (``recall`` still routes;
# ``search`` is S3) — the table is present so the hint mechanism is wired.
_DISPATCH_HINTS: dict[str, str] = {
    "search": "recall",   # ``search`` is S3; ``recall`` still routes in S2
}


def _unknown_command_hint(command: str) -> str:
    """Return a 'did you mean …?' hint for an unrecognized command, or an empty string."""
    if command in _DISPATCH_HINTS:
        replacement = _DISPATCH_HINTS[command]
        return f"did you mean 'lore {replacement}'?"
    return ""


# ---- argparse ---------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="lore", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init", help="Scaffold a new vault")
    p_init.add_argument("path")
    p_init.add_argument("--force", action="store_true", help="Scaffold into a non-empty dir")
    p_init.add_argument("--allow-outside-home", action="store_true", help="Allow a target outside $HOME")
    p_init.add_argument("--yes", action="store_true", help="Skip the confirmation prompt")
    p_init.set_defaults(func=cmd_init)

    p_patch = sub.add_parser("patch", help="Append text under a section")
    p_patch.add_argument("file")
    p_patch.add_argument("section")
    p_patch.add_argument("--text", default=None, help="Text to append (else read stdin)")
    p_patch.set_defaults(func=cmd_patch)

    p_status = sub.add_parser("set-status", help="Validate + set a note's status")
    p_status.add_argument("file")
    p_status.add_argument("value")
    p_status.set_defaults(func=cmd_set_status)

    p_stats = sub.add_parser("stats", help="Print counts for the resolved vault")
    p_stats.set_defaults(func=cmd_stats)

    p_session_note = sub.add_parser(
        "session-note",
        help="Print the session note path for this session (id-first, worktree fallback)",
    )
    p_session_note.add_argument(
        "--session-id",
        dest="session_id",
        default=None,
        help="Session id to resolve (default: $CLAUDE_CODE_SESSION_ID)",
    )
    p_session_note.add_argument(
        "--worktree",
        default=None,
        help="Worktree name for the fallback (default: auto-detected)",
    )
    p_session_note.set_defaults(func=cmd_session_note)

    p_sync = sub.add_parser("sync", help="Stage, commit, and push the vault")
    p_sync.add_argument(
        "--message", "-m", default=None,
        help=f"Commit message (default: {DEFAULT_SYNC_MSG!r})",
    )
    p_sync.set_defaults(func=cmd_sync)

    p_new = sub.add_parser("new", help="Render a template and write a new vault note")
    p_new.add_argument("type", choices=list(_NOTE_DIRS), help="Note type to create")
    p_new.add_argument("--title", required=True, help="Title for the note (used in slug)")
    p_new.add_argument("--vault", default=None, help="Vault path (overrides $LORE_VAULT)")
    p_new.add_argument("--project", default=None, help="Project name to stamp in frontmatter")
    # deferred
    p_new.add_argument("--surfaces", default=None, help="CSV area names this item surfaces on (deferred)")
    p_new.add_argument("--next-check", dest="next_check", default=None, help="When to next check (deferred)")
    p_new.add_argument("--revisit-after", dest="revisit_after", default=None, help="Date-bound revisit trigger (deferred)")
    # dead-end
    p_new.add_argument("--areas", default=None, help="CSV area names (dead-end, decision)")
    p_new.add_argument("--tried", default=None, help="Date the approach was tried (dead-end; defaults to today)")
    p_new.add_argument("--revive-condition", dest="revive_condition", default=None, help="Condition to retry (dead-end)")
    # follow-up
    p_new.add_argument("--source", default=None, help="Where updates appear (follow-up)")
    p_new.add_argument("--target", default=None, help="Version or state being waited for (follow-up)")
    p_new.add_argument("--check", default=None, help="Check cadence (follow-up)")
    # area
    p_new.add_argument("--keywords", default=None, help="CSV keywords for branch-based recall (area)")
    p_new.add_argument("--key-files", dest="key_files", default=None, help="CSV key file paths (area)")
    # plan
    p_new.add_argument("--related-areas", dest="related_areas", default=None, help="CSV area names (plan)")
    p_new.add_argument("--related-spec", dest="related_spec", default=None, help="Related spec path or wikilink (plan)")
    p_new.set_defaults(func=cmd_new)

    p_promote = sub.add_parser(
        "promote",
        help="Copy a personal note into a shared vault (interactive, TTY-gated)",
    )
    p_promote.add_argument(
        "note",
        help="Path to the personal note to promote",
    )
    p_promote.add_argument(
        "--to",
        default=None,
        help="Name of the target shared layer (required when multiple shared vaults declared)",
    )
    p_promote.add_argument(
        "--yes",
        action="store_true",
        default=False,
        help=argparse.SUPPRESS,  # Accepted but refused — keeps help clean
    )
    p_promote.set_defaults(func=cmd_promote)

    p_seed = sub.add_parser(
        "seed",
        help="Scaffold an inbox capture (named <name>) under inbox/",
    )
    p_seed.add_argument("name", help="Human-readable name; slugified for the filename")
    p_seed.add_argument("--vault", default=None, help="Vault path (overrides $LORE_VAULT)")
    p_seed.set_defaults(func=cmd_seed)

    def _add_session_selectors(p: argparse.ArgumentParser) -> None:
        """Shared overrides for the auto-detected session note."""
        p.add_argument(
            "--session-id", dest="session_id", default=None,
            help="Session id to target (default: $CLAUDE_CODE_SESSION_ID)",
        )
        p.add_argument(
            "--worktree", default=None,
            help="Worktree name for the fallback (default: auto-detected)",
        )

    p_finish = sub.add_parser(
        "finish",
        help="Finalize the active session note for this worktree",
    )
    _add_session_selectors(p_finish)
    p_finish.set_defaults(func=cmd_finish)

    p_handoff = sub.add_parser(
        "handoff",
        help="Shelve the active session note for this worktree (for pickup later)",
    )
    _add_session_selectors(p_handoff)
    p_handoff.add_argument(
        "--pickup-hints-file",
        dest="pickup_hints_file",
        default=None,
        metavar="PATH",
        help="File whose content is written under '## Pickup hints' before shelving",
    )
    p_handoff.set_defaults(func=cmd_handoff)

    p_shelved = sub.add_parser(
        "shelved",
        help="List shelved/handoff session notes (most-recent-first) for pickup",
    )
    p_shelved.add_argument(
        "--slug",
        default=None,
        help="Narrow to one worktree slug",
    )
    p_shelved.set_defaults(func=cmd_shelved)

    p_resume = sub.add_parser(
        "resume",
        help="Flip a shelved/handoff session note back to active",
    )
    p_resume.add_argument(
        "target",
        nargs="?",
        default=None,
        help="Session note path OR worktree slug to resume "
             "(omit to resume the current session's shelved note)",
    )
    _add_session_selectors(p_resume)
    p_resume.set_defaults(func=cmd_resume)

    p_areas = sub.add_parser(
        "areas",
        help="List all vault areas (names, one-liners, keywords) on demand",
    )
    p_areas.set_defaults(func=cmd_areas)

    p_recall = sub.add_parser(
        "recall",
        help="Pull area-scoped memory (decisions/lessons/dead-ends/deferred) for the agent",
    )
    p_recall.add_argument(
        "--areas",
        default="",
        help="Comma-separated area names to recall memory for",
    )
    p_recall.add_argument(
        "--json",
        action="store_true",
        default=False,
        help="Emit structured JSON instead of the human banner",
    )
    p_recall.add_argument(
        "--vault",
        default=None,
        help="Vault path (overrides $LORE_VAULT)",
    )
    p_recall.set_defaults(func=cmd_recall)

    p_reindex = sub.add_parser(
        "reindex",
        help="Rebuild the derived SQLite index from the vault directory tree",
    )
    p_reindex.add_argument(
        "--vault",
        default=None,
        help="Vault path (overrides $LORE_VAULT)",
    )
    p_reindex.set_defaults(func=cmd_reindex)

    # record subcommand: ``lore record create`` (Slice 3, S2).
    # ``--team`` is the *routing* flag (scope → place_record; AC-ROUTE1); it is
    # distinct from ``--set team=X``, which writes the sidecar ``team`` field.
    p_record = sub.add_parser(
        "record",
        help="Create, update, delete, or manage vault records",
    )
    p_record_sub = p_record.add_subparsers(dest="record_action", required=True)

    p_record_create = p_record_sub.add_parser("create", help="Create a new vault record")
    p_record_create.add_argument(
        "--kind", required=True,
        help="Record kind (one of: area, backlog, blob, collaboration, decision, "
             "lesson, plan, session, spec)",
    )
    p_record_create.add_argument(
        "--title", required=True,
        help="Human-readable title (used to derive the record name slug)",
    )
    # Routing flags (AC5, AC-ROUTE1): passed to place_record as scope.
    # These influence vault selection (S4 hook) and do NOT write sidecar fields.
    p_record_create.add_argument(
        "--repo", default=None,
        help="Routing scope: restrict to this repo's vault (AC5; no sidecar effect)",
    )
    p_record_create.add_argument(
        "--product", default=None,
        help="Routing scope: restrict to this product's vault (AC5; no sidecar effect)",
    )
    p_record_create.add_argument(
        "--suite", default=None,
        help="Routing scope: restrict to this suite's vault (AC5; no sidecar effect)",
    )
    p_record_create.add_argument(
        "--team", default=None,
        help="Routing scope: restrict to this team's vault (AC5; no sidecar effect). "
             "To set the 'team' sidecar metadata field, use --set team=VALUE instead "
             "(AC-ROUTE1).",
    )
    p_record_create.add_argument(
        "--set", dest="set_pairs", action="append", default=[],
        metavar="K=V",
        help="Set a sidecar field (repeatable). Use K=VALUE to set a scalar or "
             "append to a list. --set K=\"\" on a scalar clears the key (AC15). "
             "--set K=\"\" on a list field is a hard error (AC17; use --unset instead).",
    )
    p_record_create.add_argument(
        "--unset", dest="unset_pairs", action="append", default=[],
        metavar="K[=VALUE]",
        help="Unset a sidecar field (repeatable). --unset K=VALUE removes one list "
             "item (AC16). --unset K clears the whole key (AC18).",
    )
    p_record_create.set_defaults(func=cmd_record)

    # ``lore record update RECORD_ID`` (Slice 4, S2).
    p_record_update = p_record_sub.add_parser(
        "update", help="Update an existing vault record (full-body / --diff / metadata-only)"
    )
    p_record_update.add_argument(
        "record_id",
        metavar="RECORD_ID",
        help="The vault-relative record ID to update (<kind>/<name>)",
    )
    p_record_update.add_argument(
        "--diff", action="store_true",
        help="Treat piped stdin as a unified diff applied to the existing body "
             "(KU2). On any non-applying hunk the record is left byte-for-byte "
             "unmodified and the rejected hunks print to stderr (AC-DIFF1).",
    )
    p_record_update.add_argument(
        "--move-to", dest="move_to", default=None, metavar="VAULT",
        help="Relocate the record to a different vault root via move_record "
             "(AC12). The record physically moves and the new ID is printed.",
    )
    # Routing flags (AC5, AC-ROUTE1): accepted for parity with create; the
    # scope→different-vault routing trigger is S4's resolution (--move-to is the
    # S2 hook that exercises the move primitive directly).
    p_record_update.add_argument("--repo", default=None, help=argparse.SUPPRESS)
    p_record_update.add_argument("--product", default=None, help=argparse.SUPPRESS)
    p_record_update.add_argument("--suite", default=None, help=argparse.SUPPRESS)
    p_record_update.add_argument("--team", default=None, help=argparse.SUPPRESS)
    p_record_update.add_argument(
        "--set", dest="set_pairs", action="append", default=[],
        metavar="K=V",
        help="Set a sidecar field (repeatable). Same AC15-AC18 semantics as create.",
    )
    p_record_update.add_argument(
        "--unset", dest="unset_pairs", action="append", default=[],
        metavar="K[=VALUE]",
        help="Unset a sidecar field (repeatable). Same AC16/AC18 semantics as create.",
    )
    p_record_update.set_defaults(func=cmd_record)

    return parser


def _known_commands(parser: argparse.ArgumentParser) -> frozenset[str]:
    """Return the set of registered top-level subcommand names.

    Introspects the parser's ``_SubParsersAction`` so the unknown-command hint
    (AC-DISP1) can tell a genuinely unrecognized command from a *valid* command
    that merely failed on a sub-argument (e.g. ``record create`` missing
    ``--kind``) — the latter must NOT be mislabelled "unknown command".
    """
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return frozenset(action.choices)
    return frozenset()


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    # Intercept argparse's SystemExit so we can emit the ``did you mean …?``
    # hint (AC-DISP1) before re-raising. argparse calls sys.exit(2) on an
    # unrecognized command, so we catch that here.
    raw = argv if argv is not None else sys.argv[1:]
    try:
        args = parser.parse_args(list(raw))
    except SystemExit as exc:
        cmd = raw[0] if raw else ""
        # Only treat this as an unknown command when the first token is not a
        # flag and not a registered subcommand. A valid command that fails on a
        # sub-argument re-raises argparse's own error untouched (AC-DISP1: do
        # not swallow / mislabel legitimate argparse errors).
        if exc.code == 2 and cmd and not cmd.startswith("-") and cmd not in _known_commands(parser):
            hint = _unknown_command_hint(cmd)
            if hint:
                print(f"lore: unknown command {cmd!r}. {hint}", file=sys.stderr)
            else:
                # For any unrecognized command, print a generic prompt so agents
                # can distinguish a typo from a real error.
                print(
                    f"lore: unknown command {cmd!r}. "
                    f"Run 'lore --help' for a list of subcommands.",
                    file=sys.stderr,
                )
        raise
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
