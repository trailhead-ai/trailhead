# ---- new --------------------------------------------------------------------

# Map each note type to its vault directory.
_NOTE_DIRS: dict[str, str] = {
    "deferred": "deferred",
    "dead-end": "dead-ends",
    "decision": "decisions",
    "follow-up": "follow-ups",
    "area": "areas",
    "spec": "specs",
    "plan": "plans",
}

# Types that carry a project: field. dead-end is intentionally absent.
_PROJECT_BEARING: frozenset[str] = frozenset({"deferred", "decision", "follow-up", "area", "spec", "plan"})

# Note types stored in date-bucketed YYYY-MM subdirs (the date-bucketed archive
# layout). The date-based living folders (deferred/dead-ends/decisions/follow-ups)
# join the archive types; only singleton area profiles (name-keyed) stay
# flat at the folder root.
_BUCKETED_TYPES: frozenset[str] = frozenset(
    {"spec", "plan", "deferred", "decision", "follow-up", "dead-end"}
)

# Which section of the session note gets the backlink (None = no backlink).
_BACKLINK_SECTIONS: dict[str, str | None] = {
    "deferred": "Deferred",
    "dead-end": "Learned",
    "decision": "Decided",
    "follow-up": None,
    "area": None,
    "spec": None,
    "plan": None,
}


def _resolve_groups_dir() -> "Path | None":
    """Return the camp groups directory, or None if unavailable.

    Checks LORE_GROUPS_DIR first (for tests and overrides), then falls back
    to trailhead.paths.config_dir("camp")/"groups" via the bootstrap.
    """
    env_override = os.environ.get("LORE_GROUPS_DIR", "").strip()
    if env_override:
        return Path(env_override)
    try:
        import _bootstrap
        _bootstrap.ensure_trailhead_importable()
        import trailhead.paths as _paths
        return _paths.config_dir("camp") / "groups"
    except (ImportError, SystemExit):
        return None


def _is_tty() -> bool:
    """Return True if stdin is a real interactive TTY.

    This is the PRIMARY wall on the private→shared boundary (A-1).  There is
    intentionally NO override path — not an env-var, not a flag.  Tests that
    need to exercise the TTY path patch sys.stdin.isatty in-process via
    monkeypatch; a separate agent subprocess cannot patch production's isatty.
    """
    return sys.stdin.isatty()


def _kebab(title: str) -> str:
    """Lowercase, replace non-alphanumerics with a single hyphen, trim.

    When the result is empty (all-punctuation, whitespace, or non-Latin
    unicode), falls back to 'note-<first 6 hex chars of sha1(title)>' so the
    slug is always non-empty.
    """
    lowered = title.lower()
    slugged = re.sub(r"[^a-z0-9]+", "-", lowered)
    slug = slugged.strip("-")
    if not slug:
        digest = hashlib.sha1(title.encode()).hexdigest()[:6]
        slug = f"note-{digest}"
    return slug


def _unique_path(directory: Path, stem: str) -> Path:
    """Return a path in directory for <stem>.md that does not exist.

    If <stem>.md is free, return it. Otherwise append -2, -3, … until the
    path is free. Never overwrites an existing file.
    """
    candidate = directory / f"{stem}.md"
    if not candidate.exists():
        return candidate
    counter = 2
    while True:
        candidate = directory / f"{stem}-{counter}.md"
        if not candidate.exists():
            return candidate
        counter += 1


def _today() -> str:
    """Return today's date as YYYY-MM-DD, honoring $LORE_TODAY for tests."""
    override = os.environ.get("LORE_TODAY", "").strip()
    if override:
        return override
    return date.today().isoformat()


def _render_template(template_path: Path, substitutions: dict[str, str]) -> str:
    """Replace {{key}} placeholders in the template with provided values."""
    text = template_path.read_text()
    for key, value in substitutions.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def _csv_to_inline_list(csv: str | None) -> str:
    """Convert a comma-separated string to an inline YAML list string.

    'a, b, c' → '[a, b, c]'
    None or empty → '[]'
    """
    if not csv:
        return "[]"
    items = [k.strip() for k in csv.split(",") if k.strip()]
    if not items:
        return "[]"
    return "[" + ", ".join(items) + "]"


def cmd_new(args: argparse.Namespace) -> int:
    note_type = args.type
    if note_type not in _NOTE_DIRS:
        print(
            f"error: unknown note type {note_type!r}. "
            f"Choose from: {', '.join(sorted(_NOTE_DIRS))}",
            file=sys.stderr,
        )
        return 1

    vault = Path(args.vault).expanduser().resolve() if args.vault else Path(vault_mod.resolve_vault())

    # D-5: if --vault explicitly points at a shared layer, refuse it.
    # The raw writer must never reach a shared root.
    if args.vault:
        groups_dir = _resolve_groups_dir()
        try:
            layers = layers_mod.resolve_layers(
                cwd=Path.cwd(),
                groups_dir=groups_dir,
            )
        except Exception:
            layers = []
        shared_roots = {
            lay.root.resolve()
            for lay in layers
            if lay.kind == "shared"
        }
        if vault.resolve() in shared_roots:
            print(
                f"error: {args.vault} is a shared vault; "
                f"use 'lore promote' to write there.",
                file=sys.stderr,
            )
            return 1
    today = _today()
    user = vault_mod.resolve_user()

    # Resolve project: explicit flag wins; for project-bearing types fall back
    # to git remote inference; dead-end carries no project field at all.
    if note_type in _PROJECT_BEARING:
        project = args.project or vault_mod.resolve_project()
    else:
        project = args.project or ""

    # Build template substitutions — common fields.
    subs: dict[str, str] = {
        "date": today,
        "user": user,
        "project": project,
        "name": args.title,
    }

    # Per-type substitutions: populate frontmatter fields from CLI flags.
    if note_type == "deferred":
        subs["surfaces"] = _csv_to_inline_list(getattr(args, "surfaces", None))
        subs["next-check"] = getattr(args, "next_check", None) or ""
        revisit_after = getattr(args, "revisit_after", None) or ""
        subs["revisit-after"] = revisit_after
        # status: scheduled when revisit-after is provided, open otherwise.
        subs["status"] = "scheduled" if revisit_after else "open"

    elif note_type == "dead-end":
        subs["areas"] = _csv_to_inline_list(getattr(args, "areas", None))
        subs["tried"] = getattr(args, "tried", None) or today
        subs["revive-condition"] = getattr(args, "revive_condition", None) or ""

    elif note_type == "decision":
        subs["areas"] = _csv_to_inline_list(getattr(args, "areas", None))

    elif note_type == "follow-up":
        subs["source"] = getattr(args, "source", None) or ""
        subs["target"] = getattr(args, "target", None) or ""
        subs["check"] = getattr(args, "check", None) or ""

    elif note_type == "area":
        subs["keywords"] = _csv_to_inline_list(getattr(args, "keywords", None))
        subs["key-files"] = _csv_to_inline_list(getattr(args, "key_files", None))

    elif note_type == "spec":
        subs["areas"] = _csv_to_inline_list(getattr(args, "areas", None))

    elif note_type == "plan":
        subs["related-areas"] = _csv_to_inline_list(getattr(args, "related_areas", None))
        subs["related-spec"] = getattr(args, "related_spec", None) or ""
        subs["slug"] = _kebab(args.title)

    template_path = TEMPLATES_DIR / f"{note_type}.md"
    if not template_path.is_file():
        print(f"error: template not found: {template_path}", file=sys.stderr)
        return 1

    rendered = _render_template(template_path, subs)

    # Validate status if the note type has one.
    fm = frontmatter.parse_frontmatter_str(rendered)
    note_status = fm.get("status")
    if note_status is not None:
        if not status_validator.is_valid_status(note_type, note_status):
            permitted = status_validator.permitted_statuses(note_type)
            print(
                f"error: template status {note_status!r} is not canonical for "
                f"type {note_type!r}. permitted: {sorted(permitted) if permitted else '(unconstrained)'}",
                file=sys.stderr,
            )
            return 1

    # Write the note — area profiles are singletons identified by their
    # bare kebab name (no date prefix). All other types get YYYY-MM-DD-<slug>
    # naming with collision handling.
    note_dir = vault / _NOTE_DIRS[note_type]
    if note_type in _BUCKETED_TYPES:
        note_dir = vault_mod.bucket_dir(note_dir, today)
    note_dir.mkdir(parents=True, exist_ok=True)
    if note_type == "area":
        stem = _kebab(args.title)
        note_path = note_dir / f"{stem}.md"
        if note_path.exists():
            print(
                f"error: area profile '{stem}' already exists at {note_path} — "
                "edit it directly (lore new area creates a new profile).",
                file=sys.stderr,
            )
            return 1
    else:
        stem = f"{today}-{_kebab(args.title)}"
        note_path = _unique_path(note_dir, stem)
    note_path.write_text(rendered)

    # D-4: print [personal] label only when a shared vault is declared.
    # Resolving layers here is cheap (cached from the D-5 check above when --vault
    # was passed; resolved fresh otherwise).
    groups_dir = _resolve_groups_dir()
    try:
        all_layers = layers_mod.resolve_layers(cwd=Path.cwd(), groups_dir=groups_dir)
    except Exception:
        all_layers = []
    has_shared = any(lay.kind == "shared" for lay in all_layers)
    if has_shared:
        print(f"Created: {note_path} [personal]")
    else:
        print(f"Created: {note_path}")

    # Backlink to session note (deferred/dead-end/decision only).
    section = _BACKLINK_SECTIONS[note_type]
    if section is not None:
        worktree_name = Path.cwd().name
        session_note = vault_mod.find_session_note(vault, worktree_name=worktree_name)
        if session_note is None:
            print(
                f"note: no active session note found — backlink to {section!r} skipped.",
                file=sys.stderr,
            )
        else:
            # Use the note's full vault-relative path (minus suffix) so the
            # wikilink resolves whether the note is flat or YYYY-MM-bucketed —
            # `[[deferred/<stem>]]` would not resolve once bucketed.
            rel_link = note_path.relative_to(vault).with_suffix("").as_posix()
            title_display = args.title
            backlink = f"- [[{rel_link}]] — {title_display}"
            frontmatter.patch_section(session_note, section, backlink)

    return 0


# ---- promote ----------------------------------------------------------------

def cmd_promote(args: argparse.Namespace) -> int:
    """Copy a personal note into a shared vault, gated by interactive TTY confirm.

    A-1: refused immediately if sys.stdin.isatty() is False (no override path).
    D-2: --yes is refused.
    D-1: actionable error when no shared vault is declared.
    C-4: overlap blocks promote (unlike recall which degrades).
    """
    note_path = Path(args.note).expanduser().resolve()

    # A-1 (FIRST line of cmd_promote, before any I/O / preview / token):
    # Refuse if stdin is not a real TTY. No override path exists.
    if not _is_tty():
        note_arg = str(args.note)
        to_arg = f" --to {args.to}" if getattr(args, "to", None) else ""
        print(
            f"lore: promote refused — stdin is not an interactive terminal.\n"
            f"The agent cannot self-approve a shared vault write.\n"
            f"Run this yourself in an interactive terminal:  "
            f"lore promote {note_arg}{to_arg}",
            file=sys.stderr,
        )
        return 1

    # D-2: --yes is refused.
    if getattr(args, "yes", False):
        note_arg = str(args.note)
        to_arg = f" --to {args.to}" if getattr(args, "to", None) else ""
        print(
            f"lore: promote refused — non-interactive promote is not allowed.\n"
            f"The interactive confirm is mandatory (no --yes path).\n"
            f"Run this yourself in an interactive terminal:  "
            f"lore promote {note_arg}{to_arg}",
            file=sys.stderr,
        )
        return 1

    # Note must exist.
    if not note_path.exists():
        print(
            f"lore: promote refused — note not found: {note_path}",
            file=sys.stderr,
        )
        return 1

    # Resolve layers — using the camp-aware path, NOT the recall degradation path.
    # C-4: overlap blocks promote (we need an unambiguous target).
    groups_dir = _resolve_groups_dir()
    try:
        all_layers = _resolve_layers_for_promote(groups_dir)
    except _PromoteOverlapError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"lore: could not resolve layers: {exc}", file=sys.stderr)
        return 1

    shared_layers = [lay for lay in all_layers if lay.kind == "shared"]

    # D-1: no shared vault declared → actionable error.
    if not shared_layers:
        config_path = groups_dir / "*.toml" if groups_dir else Path("~/.config/camp/groups/")
        # Try to give the actual group config path if we can
        if groups_dir and groups_dir.exists():
            toml_files = list(groups_dir.glob("*.toml"))
            if toml_files:
                config_path = toml_files[0]
            else:
                config_path = groups_dir / "<group>.toml"
        elif groups_dir:
            config_path = groups_dir / "<group>.toml"
        else:
            config_path = Path("~/.config/camp/groups/<group>.toml")

        print(
            f"lore: no shared vault declared for this group.\n"
            f"add a [[shared_vaults]] block to your group config at {config_path}:\n"
            f"\n"
            f"    [[shared_vaults]]\n"
            f'    name = "team"\n'
            f'    root = "/path/to/team-vault"\n',
            file=sys.stderr,
        )
        return 1

    # Resolve target shared layer.
    to_name = getattr(args, "to", None)
    if len(shared_layers) == 1 and not to_name:
        target_layer = shared_layers[0]
    elif to_name:
        matching = [lay for lay in shared_layers if lay.name == to_name]
        if not matching:
            available = ", ".join(lay.name for lay in shared_layers)
            print(
                f"lore: unknown shared layer {to_name!r}. "
                f"Available: {available}",
                file=sys.stderr,
            )
            return 1
        target_layer = matching[0]
    else:
        # Multiple shared layers, no --to specified.
        available = ", ".join(lay.name for lay in shared_layers)
        print(
            f"lore: multiple shared vaults declared; specify --to <name>. "
            f"Available: {available}",
            file=sys.stderr,
        )
        return 1

    dest = target_layer.root / note_path.name

    # Preview (D-5): source, exact destination, WARNING: SHARED prefix.
    print(f"  Source: {note_path}")
    print(f"  Destination: {dest}")
    print(f"  WARNING: writing to SHARED vault [{target_layer.name}]")
    print()

    # Interactive confirm.
    try:
        answer = input("Promote? [y/N] ").strip().lower()
    except EOFError:
        answer = ""

    if answer not in ("y", "yes"):
        print("Aborted; nothing written.")
        return 0

    # Resolve the token store.
    token_dir = _resolve_token_dir()

    # Mint token (A-1: tty_confirmed=True because _is_tty() passed above).
    try:
        token = promote_mod.mint_token(
            token_dir, note_path, target_layer.name, tty_confirmed=True
        )
    except promote_mod.PromoteRefusedError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1

    # Write to shared (the single gated entry point).
    try:
        result_dest = promote_mod.write_to_shared(
            note_path, target_layer, token=token, token_dir=token_dir
        )
    except promote_mod.PromoteRefusedError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"lore: promote failed: {exc}", file=sys.stderr)
        return 1

    print(f"Promoted: {note_path} → [shared:{target_layer.name}] {result_dest}")
    return 0


class _PromoteOverlapError(Exception):
    """Raised when multiple groups claim the cwd and promote cannot pick one."""


def _resolve_layers_for_promote(groups_dir: "Path | None") -> list:
    """Resolve layers for promote, raising _PromoteOverlapError on group overlap.

    Unlike recall (which degrades on overlap), promote must have an unambiguous
    target (C-4). This re-runs the discovery but surfaces the overlap rather than
    swallowing it.
    """
    camp_plugin_root = None
    for _p in (Path(__file__).resolve(), *Path(__file__).resolve().parents):
        if (_p / "trailhead" / "paths.py").exists():
            camp_plugin_root = _p / "tools" / "camp" / "plugins"
            break

    if camp_plugin_root is not None and str(camp_plugin_root) not in sys.path:
        sys.path.insert(0, str(camp_plugin_root))

    try:
        import camp.scripts.group_config as _gc
        import camp.scripts.group_resolve as _gr
        from camp.scripts.group_config import GroupConfigError
        from camp.scripts.group_resolve import GroupResolutionError
    except ImportError:
        # camp absent — personal-only, no shared vaults.
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    if groups_dir is None or not groups_dir.exists():
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    try:
        group_configs = _gc.load_all_groups(groups_dir)
    except GroupConfigError as exc:
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    from vault import resolve_vault
    personal_root = Path(resolve_vault())
    personal_layer = layers_mod.VaultLayer(
        name="personal", root=personal_root, kind="personal", trusted=True
    )

    if not group_configs:
        return [personal_layer]

    cwd = Path.cwd()
    try:
        group_name, _slug = _gr.resolve_from_cwd(cwd, group_configs)
    except GroupResolutionError as exc:
        exc_msg = str(exc)
        # C-4: overlap blocks promote
        if "multiple groups" in exc_msg or "multiple" in exc_msg.lower():
            raise _PromoteOverlapError(exc_msg) from exc
        # cwd not in any group → no shared vaults
        return [personal_layer]

    for cfg in group_configs:
        if cfg["group"]["name"] == group_name:
            shared_vaults_raw = cfg.get("shared_vaults", [])
            toml_path = cfg.get("_toml_path", "")
            layers = [personal_layer]
            for sv in shared_vaults_raw:
                sv_name = sv["name"]
                sv_root_str = sv["root"]
                sv_root = Path(sv_root_str)
                if not sv_root.is_absolute() and toml_path:
                    sv_root = Path(toml_path).parent / sv_root
                resolved = sv_root.resolve()
                if resolved.is_dir() and resolved != personal_root.resolve():
                    layers.append(layers_mod.VaultLayer(
                        name=sv_name, root=resolved, kind="shared", trusted=False
                    ))
            return layers

    return [personal_layer]


def _resolve_token_dir() -> Path:
    """Return the token store directory, using trailhead.paths if available."""
    try:
        import _bootstrap
        _bootstrap.ensure_trailhead_importable()
        import trailhead.paths as _paths
        token_dir = _paths.state_dir("lore") / "promote-tokens"
    except (ImportError, SystemExit):
        # Fallback: use ~/.local/state/lore/promote-tokens
        token_dir = Path.home() / ".local" / "state" / "lore" / "promote-tokens"
    return token_dir


# ---- seed -------------------------------------------------------------------

def cmd_seed(args: argparse.Namespace) -> int:
    """Scaffold an inbox capture named <slug> under inbox/.

    Idempotent: the note is keyed by name alone (no date prefix), so if a note
    for this name already exists it is left as-is, never overwritten. The note
    carries minimal frontmatter (type: inbox, date, status: new) and an H1 of
    the human-readable name.
    """
    vault = Path(args.vault).expanduser().resolve() if args.vault else Path(vault_mod.resolve_vault())
    today = _today()

    note_dir = vault / "inbox"
    note_dir.mkdir(parents=True, exist_ok=True)
    note_path = note_dir / f"{_kebab(args.name)}.md"

    if note_path.exists():
        print(f"Exists: {note_path}")
        return 0

    template_path = TEMPLATES_DIR / "inbox.md"
    if not template_path.is_file():
        print(f"error: template not found: {template_path}", file=sys.stderr)
        return 1
    rendered = _render_template(template_path, {"date": today, "name": args.name})
    note_path.write_text(rendered)
    print(f"Created: {note_path}")
    return 0


# ---- init -------------------------------------------------------------------

def _is_under_home(target: Path) -> bool:
    home = Path.home().resolve()
    try:
        target.relative_to(home)
        return True
    except ValueError:
        return False


def _planned_tree(target: Path) -> str:
    lines = [f"{target}/"]
    for d in TAXONOMY:
        lines.append(f"  {d}/")
    lines.append("  .templates/")
    for doc in STARTER_DOCS:
        lines.append(f"  {doc}")
    lines.append("  harvest-pending.md")
    return "\n".join(lines)


def cmd_init(args: argparse.Namespace) -> int:
    target = Path(args.path).expanduser().resolve()

    if not _is_under_home(target) and not args.allow_outside_home:
        print(
            f"error: refusing to init outside $HOME: {target}\n"
            "pass --allow-outside-home to override.",
            file=sys.stderr,
        )
        return 1

    if target.exists() and any(target.iterdir()) and not args.force:
        print(
            f"error: refusing to init a non-empty directory: {target}\n"
            "pass --force to scaffold into it anyway (existing files are kept).",
            file=sys.stderr,
        )
        return 1

    print("Planned vault layout:")
    print(_planned_tree(target))
    print()

    if not args.yes:
        try:
            answer = input(f"Create this vault at {target}? [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        if answer not in ("y", "yes"):
            print("Aborted; nothing written.", file=sys.stderr)
            return 1

    # Scaffold.
    target.mkdir(parents=True, exist_ok=True)
    for d in TAXONOMY:
        (target / d).mkdir(exist_ok=True)

    templates_out = target / ".templates"
    templates_out.mkdir(exist_ok=True)
    if TEMPLATES_DIR.is_dir():
        for item in sorted(TEMPLATES_DIR.iterdir()):
            if item.name == ".gitkeep":
                continue
            dest = templates_out / item.name
            if item.is_dir():
                shutil.copytree(item, dest, dirs_exist_ok=True)
            else:
                shutil.copy2(item, dest)

    for doc in STARTER_DOCS:
        src = STARTER_DIR / doc
        (target / doc).write_text(src.read_text())

    (target / "harvest-pending.md").write_text(
        "# Harvest pending\n\n"
        "Staging area for harvest candidates emitted by subagents. The session "
        "wrap-up ritual reads and clears this file.\n"
    )

    # Git-init the vault if it isn't already a git repo.
    git_dir = target / ".git"
    if not git_dir.is_dir():
        result = subprocess.run(
            ["git", "init", str(target)],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"warning: git init failed: {result.stderr.strip()}", file=sys.stderr)
        else:
            print(f"Initialized git repo at {target}")

    # Install the pre-commit status guard.
    installer = PLUGIN_ROOT / "hooks" / "install-vault-hooks.sh"
    if installer.is_file():
        env = dict(os.environ)
        env["LORE_PLUGIN_ROOT"] = str(PLUGIN_ROOT)
        result = subprocess.run(
            ["bash", str(installer), str(target)],
            capture_output=True, text=True, env=env,
        )
        if result.returncode != 0:
            print(f"warning: guard install failed: {result.stderr.strip()}", file=sys.stderr)
        else:
            print(result.stdout.strip())

    print(f"\nInitialized lore vault at {target}\n")
    print(f"export LORE_VAULT={target}")
    print(
        "Add that line to your shell profile. Without LORE_VAULT set, lore "
        "uses the default ~/lore instead of this vault."
    )
    return 0


