def cmd_seed(args: argparse.Namespace) -> int:
    """Scaffold an inbox capture named <slug> under inbox/.

    Idempotent: the note is keyed by name alone (no date prefix), so if a note
    for this name already exists it is left as-is, never overwritten. The note
    carries minimal frontmatter (type: inbox, date, status: new) and an H1 of
    the human-readable name.
    """
    vault = Path(args.vault).expanduser().resolve() if args.vault else Path(vault_mod.resolve_vault())
    today = _today()

    note_dir = vault / "inbox"
    note_dir.mkdir(parents=True, exist_ok=True)
    note_path = note_dir / f"{_kebab(args.name)}.md"

    if note_path.exists():
        print(f"Exists: {note_path}")
        return 0

    template_path = TEMPLATES_DIR / "inbox.md"
    if not template_path.is_file():
        print(f"error: template not found: {template_path}", file=sys.stderr)
        return 1
    rendered = _render_template(template_path, {"date": today, "name": args.name})
    note_path.write_text(rendered)
    print(f"Created: {note_path}")
    return 0


