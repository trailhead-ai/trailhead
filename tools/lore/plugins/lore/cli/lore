def _load_vault_config():
    """Return ``(config_path, list[Vault])`` if config.json exists & loads, else ``None``.

    The single gate for all S4 config-driven behavior (Slice 5): routing, config-
    sourced ``shared`` reindex, config-freshness signal, and the orphan-ID guard
    all fire **only** when this returns a value. A missing ``config.json`` returns
    ``None`` so every path falls back to vanilla (Axiom 3 — support vanilla usage).

    A *present but malformed/invalid* config returns ``None`` too: the freshness +
    routing layers are best-effort, and a broken config must not brick a plain
    ``record create``; ``lore vault ls``/``add`` are the surfaces that surface the
    config error explicitly.
    """
    config_path = _resolve_config_path()
    if not config_path.exists():
        return None
    try:
        vaults = vault_config_mod.load_config(str(config_path))
    except (vault_config_mod.VaultConfigError, OSError, ValueError):
        return None
    return config_path, vaults


def _orphan_vault_guard(vault_root: str) -> str | None:
    """Return an error message iff *vault_root* is not a currently-configured vault.

    The orphaned-RECORD_ID guard (Slice 5, S4): a record's target vault may have
    been removed by a later ``config.json`` edit / ``vault delete``. ``record
    update``/``delete`` call this **only when a config exists**; when it returns a
    message the caller fails non-zero rather than acting on an orphaned target.

    Conservative + vanilla-safe (Axiom 3): returns ``None`` (no guard) when no
    config is present, so single-vault usage is never rejected. When a config IS
    present, the resolved vault root path is matched against the configured vaults'
    resolved paths (the index ``vault`` column stores the resolved root path, not
    the config name — so path identity, realpath-normalized, is the right key).
    """
    loaded = _load_vault_config()
    if loaded is None:
        return None
    _, vaults = loaded
    target = os.path.realpath(vault_root)
    configured = {os.path.realpath(str(v.path)) for v in vaults}
    if target in configured:
        return None
    return (
        f"lore: vault {vault_root} is not currently configured"
    )


def _resolve_record_op_vault(record_id: str, args: argparse.Namespace) -> str:
    """Resolve the vault root that ``record update``/``delete`` should act on.

    Symmetric with ``record create`` (S4): when a ``config.json`` exists, the
    target vault is chosen by the SAME config resolution — the record's ``kind``
    (from ``record_id``) plus the command's routing flags (``--repo/--product/
    --suite/--team``) — so update/delete operate on the very vault create routed
    the record to (a no-scope record lands in, and is updated from, the
    ``default`` vault). When **no** config exists, fall back to the active vault
    (``vault.resolve_vault()``) — vanilla usage is unchanged (Axiom 3).

    NOTE (scoped fix, 2026-06-18): this reconciles the create-vs-update/delete
    location split that the config-routing work introduced. The broader removal
    of ``$LORE_VAULT`` in favor of config-only resolution across *every* lore
    command (and the hooks) is tracked as a follow-up — see [[config-only-vault-resolution]].
    """
    loaded = _load_vault_config()
    if loaded is None:
        return str(vault_mod.resolve_vault())
    _, vaults = loaded
    kind = record_id.split("/", 1)[0]
    participating_scopes = {
        flag: getattr(args, flag)
        for flag in ("repo", "product", "suite", "team")
        if getattr(args, flag, None)
    }
    chosen = vault_resolve_mod.resolve_vault(participating_scopes, kind, vaults)
    return str(chosen.path)


