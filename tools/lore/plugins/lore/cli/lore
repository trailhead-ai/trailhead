def cmd_promote(args: argparse.Namespace) -> int:
    """Copy a personal note into a shared vault, gated by interactive TTY confirm.

    A-1: refused immediately if sys.stdin.isatty() is False (no override path).
    D-2: --yes is refused.
    D-1: actionable error when no shared vault is declared.
    C-4: overlap blocks promote (unlike recall which degrades).
    """
    note_path = Path(args.note).expanduser().resolve()

    # A-1 (FIRST line of cmd_promote, before any I/O / preview / token):
    # Refuse if stdin is not a real TTY. No override path exists.
    if not _is_tty():
        note_arg = str(args.note)
        to_arg = f" --to {args.to}" if getattr(args, "to", None) else ""
        print(
            f"lore: promote refused — stdin is not an interactive terminal.\n"
            f"The agent cannot self-approve a shared vault write.\n"
            f"Run this yourself in an interactive terminal:  "
            f"lore promote {note_arg}{to_arg}",
            file=sys.stderr,
        )
        return 1

    # D-2: --yes is refused.
    if getattr(args, "yes", False):
        note_arg = str(args.note)
        to_arg = f" --to {args.to}" if getattr(args, "to", None) else ""
        print(
            f"lore: promote refused — non-interactive promote is not allowed.\n"
            f"The interactive confirm is mandatory (no --yes path).\n"
            f"Run this yourself in an interactive terminal:  "
            f"lore promote {note_arg}{to_arg}",
            file=sys.stderr,
        )
        return 1

    # Note must exist.
    if not note_path.exists():
        print(
            f"lore: promote refused — note not found: {note_path}",
            file=sys.stderr,
        )
        return 1

    # Resolve layers — using the camp-aware path, NOT the recall degradation path.
    # C-4: overlap blocks promote (we need an unambiguous target).
    groups_dir = _resolve_groups_dir()
    try:
        all_layers = _resolve_layers_for_promote(groups_dir)
    except _PromoteOverlapError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"lore: could not resolve layers: {exc}", file=sys.stderr)
        return 1

    shared_layers = [lay for lay in all_layers if lay.kind == "shared"]

    # D-1: no shared vault declared → actionable error.
    if not shared_layers:
        config_path = groups_dir / "*.toml" if groups_dir else Path("~/.config/camp/groups/")
        # Try to give the actual group config path if we can
        if groups_dir and groups_dir.exists():
            toml_files = list(groups_dir.glob("*.toml"))
            if toml_files:
                config_path = toml_files[0]
            else:
                config_path = groups_dir / "<group>.toml"
        elif groups_dir:
            config_path = groups_dir / "<group>.toml"
        else:
            config_path = Path("~/.config/camp/groups/<group>.toml")

        print(
            f"lore: no shared vault declared for this group.\n"
            f"add a [[shared_vaults]] block to your group config at {config_path}:\n"
            f"\n"
            f"    [[shared_vaults]]\n"
            f'    name = "team"\n'
            f'    root = "/path/to/team-vault"\n',
            file=sys.stderr,
        )
        return 1

    # Resolve target shared layer.
    to_name = getattr(args, "to", None)
    if len(shared_layers) == 1 and not to_name:
        target_layer = shared_layers[0]
    elif to_name:
        matching = [lay for lay in shared_layers if lay.name == to_name]
        if not matching:
            available = ", ".join(lay.name for lay in shared_layers)
            print(
                f"lore: unknown shared layer {to_name!r}. "
                f"Available: {available}",
                file=sys.stderr,
            )
            return 1
        target_layer = matching[0]
    else:
        # Multiple shared layers, no --to specified.
        available = ", ".join(lay.name for lay in shared_layers)
        print(
            f"lore: multiple shared vaults declared; specify --to <name>. "
            f"Available: {available}",
            file=sys.stderr,
        )
        return 1

    dest = target_layer.root / note_path.name

    # Preview (D-5): source, exact destination, WARNING: SHARED prefix.
    print(f"  Source: {note_path}")
    print(f"  Destination: {dest}")
    print(f"  WARNING: writing to SHARED vault [{target_layer.name}]")
    print()

    # Interactive confirm.
    try:
        answer = input("Promote? [y/N] ").strip().lower()
    except EOFError:
        answer = ""

    if answer not in ("y", "yes"):
        print("Aborted; nothing written.")
        return 0

    # Resolve the token store.
    token_dir = _resolve_token_dir()

    # Mint token (A-1: tty_confirmed=True because _is_tty() passed above).
    try:
        token = promote_mod.mint_token(
            token_dir, note_path, target_layer.name, tty_confirmed=True
        )
    except promote_mod.PromoteRefusedError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1

    # Write to shared (the single gated entry point).
    try:
        result_dest = promote_mod.write_to_shared(
            note_path, target_layer, token=token, token_dir=token_dir
        )
    except promote_mod.PromoteRefusedError as exc:
        print(f"lore: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"lore: promote failed: {exc}", file=sys.stderr)
        return 1

    print(f"Promoted: {note_path} → [shared:{target_layer.name}] {result_dest}")
    return 0


class _PromoteOverlapError(Exception):
    """Raised when multiple groups claim the cwd and promote cannot pick one."""


def _resolve_layers_for_promote(groups_dir: "Path | None") -> list:
    """Resolve layers for promote, raising _PromoteOverlapError on group overlap.

    Unlike recall (which degrades on overlap), promote must have an unambiguous
    target (C-4). This re-runs the discovery but surfaces the overlap rather than
    swallowing it.
    """
    camp_plugin_root = None
    for _p in (Path(__file__).resolve(), *Path(__file__).resolve().parents):
        if (_p / "trailhead" / "paths.py").exists():
            camp_plugin_root = _p / "tools" / "camp" / "plugins"
            break

    if camp_plugin_root is not None and str(camp_plugin_root) not in sys.path:
        sys.path.insert(0, str(camp_plugin_root))

    try:
        import camp.scripts.group_config as _gc
        import camp.scripts.group_resolve as _gr
        from camp.scripts.group_config import GroupConfigError
        from camp.scripts.group_resolve import GroupResolutionError
    except ImportError:
        # camp absent — personal-only, no shared vaults.
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    if groups_dir is None or not groups_dir.exists():
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    try:
        group_configs = _gc.load_all_groups(groups_dir)
    except GroupConfigError as exc:
        from vault import resolve_vault
        personal_root = Path(resolve_vault())
        return [layers_mod.VaultLayer(
            name="personal", root=personal_root, kind="personal", trusted=True
        )]

    from vault import resolve_vault
    personal_root = Path(resolve_vault())
    personal_layer = layers_mod.VaultLayer(
        name="personal", root=personal_root, kind="personal", trusted=True
    )

    if not group_configs:
        return [personal_layer]

    cwd = Path.cwd()
    try:
        group_name, _slug = _gr.resolve_from_cwd(cwd, group_configs)
    except GroupResolutionError as exc:
        exc_msg = str(exc)
        # C-4: overlap blocks promote
        if "multiple groups" in exc_msg or "multiple" in exc_msg.lower():
            raise _PromoteOverlapError(exc_msg) from exc
        # cwd not in any group → no shared vaults
        return [personal_layer]

    for cfg in group_configs:
        if cfg["group"]["name"] == group_name:
            shared_vaults_raw = cfg.get("shared_vaults", [])
            toml_path = cfg.get("_toml_path", "")
            layers = [personal_layer]
            for sv in shared_vaults_raw:
                sv_name = sv["name"]
                sv_root_str = sv["root"]
                sv_root = Path(sv_root_str)
                if not sv_root.is_absolute() and toml_path:
                    sv_root = Path(toml_path).parent / sv_root
                resolved = sv_root.resolve()
                if resolved.is_dir() and resolved != personal_root.resolve():
                    layers.append(layers_mod.VaultLayer(
                        name=sv_name, root=resolved, kind="shared", trusted=False
                    ))
            return layers

    return [personal_layer]


