def cmd_set_status(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    if not path.is_file():
        print(f"error: no such file: {path}", file=sys.stderr)
        return 1
    meta = frontmatter.parse_frontmatter(path)
    note_type = meta.get("type")
    if not status_validator.is_valid_status(note_type, args.value):
        permitted = status_validator.permitted_statuses(note_type)
        permitted_str = sorted(permitted) if permitted else "(unconstrained)"
        print(
            f"error: status {args.value!r} is not canonical for type {note_type!r}\n"
            f"  permitted: {permitted_str}",
            file=sys.stderr,
        )
        return 1
    if not frontmatter.set_status(path, args.value):
        print(f"error: {path} has no frontmatter block", file=sys.stderr)
        return 1
    return 0


# ---- sync -------------------------------------------------------------------

DEFAULT_SYNC_MSG = "lore: sync vault"


def _git(vault: Path, *args: str) -> tuple[int, str, str]:
    """Run a git command in the vault. Returns (returncode, stdout, stderr)."""
    try:
        result = subprocess.run(
            ["git", "-C", str(vault), *args],
            capture_output=True, text=True, timeout=60,
        )
        return result.returncode, (result.stdout or "").strip(), (result.stderr or "").strip()
    except Exception as e:
        return 1, "", f"{type(e).__name__}: {e}"


def _vault_is_git_toplevel(vault: Path) -> bool:
    rc, out, _ = _git(vault, "rev-parse", "--show-toplevel")
    if rc != 0 or not out:
        return False
    try:
        return Path(out).resolve() == vault.resolve()
    except Exception:
        return False


def cmd_sync(args: argparse.Namespace) -> int:
    vault = Path(vault_mod.resolve_vault())

    if not vault.exists():
        print(f"error: vault not found: {vault}", file=sys.stderr)
        return 1

    if not _vault_is_git_toplevel(vault):
        print(
            f"error: vault is not its own git toplevel: {vault}\n"
            "  (vault may be a subdirectory of a larger repo, or not a git repo)\n"
            "  Aborting — refusing to operate on the wrong tree.",
            file=sys.stderr,
        )
        return 1

    message = getattr(args, "message", None) or DEFAULT_SYNC_MSG

    # Stage everything.
    rc, _, stderr = _git(vault, "add", "-A")
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    # Check if there's anything to commit.
    rc, status_out, _ = _git(vault, "status", "--porcelain")
    if rc != 0 or not status_out.strip():
        print("Nothing to commit — vault is clean.")
        return 0

    # Commit — never pass -S or --no-gpg-sign; honor adopter's commit.gpgsign.
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    # Push to origin if it exists.
    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0

    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print(
            f"notice: committed locally; push failed — re-run `lore sync` when online",
            file=sys.stderr,
        )
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


# ---- finish -----------------------------------------------------------------

def _get_current_status(note: Path) -> str | None:
    """Return the current status value for a session note, or None.

    Reads frontmatter first (the legacy date-prefixed shape). For a body-only
    GUID note the finalized status lives in the sibling `sessions/<GUID>.json`
    sidecar (A-sidecar), so fall back to the sidecar when frontmatter carries no
    status. Never raises.
    """
    try:
        fm = frontmatter.parse_frontmatter(note)
        status = fm.get("status")
        if status is not None:
            return str(status)
    except Exception:
        pass
    sidecar = note.with_suffix(".json")
    if sidecar.exists():
        try:
            obj = json.loads(sidecar.read_text())
            status = obj.get("status") if isinstance(obj, dict) else None
            if status is not None:
                return str(status)
        except Exception:
            return None
    return None


def _commit_and_push_session_note(vault: Path, session_note: Path, worktree_name: str, verb: str) -> int:
    """Stage, commit, and push a single session note. Returns exit code."""
    if not vault.exists():
        print(f"notice: vault not found: {vault} — skipping commit.", file=sys.stderr)
        return 0

    if not _vault_is_git_toplevel(vault):
        print(
            "notice: vault is not its own git toplevel — skipping commit.",
            file=sys.stderr,
        )
        return 0

    rc, _, stderr = _git(vault, "add", "--", str(session_note))
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    rc, status_out, _ = _git(vault, "status", "--porcelain")
    if rc != 0 or not status_out.strip():
        print("Nothing to commit — vault is clean.")
        return 0

    message = f"session: {verb} {worktree_name}"
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0

    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print(
            "notice: committed locally; push failed — re-run `lore sync` when online",
            file=sys.stderr,
        )
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


def _finish_commit(vault: Path, session_note: Path, worktree_name: str) -> int:
    """Stage the session note's explicit path(s) + commit them in a SINGLE commit.

    Never `git add -A` — only the finalized note and its metadata sidecar are
    staged, so unrelated dirty vault files are not swept in. For a body-only
    GUID note the finalized status lives in the sibling `sessions/<GUID>.json`
    sidecar (A-sidecar), so that path is staged alongside the `.md` when it
    exists. The staged-index gate (`git diff --cached --quiet`) makes an
    already-clean finish a no-op rather than a failed empty commit. Returns exit
    code."""
    if not vault.exists() or not _vault_is_git_toplevel(vault):
        print("notice: vault is not its own git toplevel — skipping commit.", file=sys.stderr)
        return 0

    paths = [str(session_note)]
    sidecar = session_note.with_suffix(".json")
    if sidecar.exists():
        paths.append(str(sidecar))
    rc, _, stderr = _git(vault, "add", "--", *paths)
    if rc != 0:
        print(f"error: git add failed: {stderr}", file=sys.stderr)
        return 1

    rc, _, _ = _git(vault, "diff", "--cached", "--quiet")
    if rc == 0:
        print("Nothing to commit — index is clean.")
        return 0

    message = f"session: finalize {worktree_name}"
    rc, _, stderr = _git(vault, "commit", "-m", message)
    if rc != 0:
        print(f"error: git commit failed: {stderr}", file=sys.stderr)
        return 1
    print(f"Committed: {message}")

    rc_remote, remote_url, _ = _git(vault, "remote", "get-url", "origin")
    if rc_remote != 0 or not remote_url:
        print("No origin remote — skipping push.")
        return 0
    rc_push, _, stderr_push = _git(vault, "push", "origin")
    if rc_push != 0:
        print("notice: committed locally; push failed — re-run `lore sync` when online", file=sys.stderr)
        print(f"  push error: {stderr_push}", file=sys.stderr)
        return 0
    print("Pushed to origin.")
    return 0


def cmd_finish(args: argparse.Namespace) -> int:
    """Finalize the active session note for the current worktree (finalize + commit).

    Resolves the session note via `vault.resolve_session_note()` — exact
    session-id match first (so the *current* session's note is finalized even
    when several exist for this worktree; this matches the body-only GUID capture
    file `sessions/<id>.md` as well as the legacy frontmatter note, Slice 0.5),
    then a worktree-name fallback. Sets `status: complete` and `ended:` (atomic
    write; for a body-only GUID note the metadata is written to a
    `sessions/<GUID>.json` sidecar, A-sidecar, leaving the `.md` body-only) and
    commits the session note (plus its sidecar) in ONE commit (explicit paths
    only — unrelated dirty vault files are not swept in). If no active session
    note is found, prints a notice and exits 0.
    """
    vault = Path(vault_mod.resolve_vault())
    session_id = _session_id_from_args_or_env(args)
    worktree_name = args.worktree or vault_mod.detect_worktree_name()

    session_note = vault_mod.resolve_session_note(
        vault, session_id=session_id, worktree_name=worktree_name
    )
    if session_note is None:
        print(
            f"notice: no active session note found for worktree {worktree_name!r} — "
            "nothing to finalize.",
        )
        return 0

    now_iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    ok = sessions_mod.finalize_note(session_note, now_iso)
    if ok:
        print(f"Finalized: {session_note.name}")
    else:
        # Already terminal: nothing to re-stamp. Still attempt the commit so a
        # prior finalize that failed to commit can be recovered; if the index is
        # clean the commit is a no-op.
        current_status = _get_current_status(session_note)
        label = current_status if current_status else "terminal"
        print(f"notice: already {label} — nothing to finalize.")

    return _finish_commit(vault, session_note, worktree_name)


