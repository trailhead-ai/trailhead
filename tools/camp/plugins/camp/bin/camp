#!/usr/bin/env bash
# bin/camp — PATH wrapper for the camp CLI.
#
# Claude Code auto-adds a plugin's bin/ directory to Bash PATH when the plugin
# is enabled, so this wrapper makes bare `camp` resolve for any install.
#
# Resolution order:
#   1. ${CLAUDE_PLUGIN_ROOT}/cli/camp  — set by Claude Code at plugin load time
#   2. Self-relative (macOS-safe, no GNU readlink -f): resolve symlinks via a
#      while loop, then find cli/camp as a sibling of bin/
#
# bin/ and cli/ are siblings under plugins/camp/, so cli/camp is at
# <plugin_root>/cli/camp regardless of how this wrapper was invoked.

set -euo pipefail

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -x "${CLAUDE_PLUGIN_ROOT}/cli/camp" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
    CLI="${CLAUDE_PLUGIN_ROOT}/cli/camp"
else
    # Symlink-safe self-resolution (macOS does not ship GNU readlink -f).
    SOURCE="${BASH_SOURCE[0]}"
    while [ -L "$SOURCE" ]; do
        DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
        SOURCE="$(readlink "$SOURCE")"
        # Handle relative symlinks.
        [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    PLUGIN_DIR="$(cd -P "$BIN_DIR/.." && pwd)"
    CLI="$PLUGIN_DIR/cli/camp"
fi

# Interpreter selection — a bare `python3` on a non-interactive ssh PATH can
# resolve to an interpreter far below the repo's declared floor (e.g. macOS
# system Python 3.9 when Homebrew's 3.14 isn't on that PATH). Read the floor
# from the nearest ancestor pyproject.toml declaring `requires-python`,
# searching upward from PLUGIN_DIR (bounded, so it can never drift into an
# unbounded walk), so it can never drift from the declared value either, and
# search every `python3` on PATH (in PATH order) for one that satisfies it.
# On the ${CLAUDE_PLUGIN_ROOT}-resolved branch, PLUGIN_DIR is a composed
# plugin tree that may carry no pyproject.toml at all in any ancestor — that
# is a real, if currently latent, case (Claude Code installs a plugin copy
# with no such file), not a bug in the search: when the floor can't be
# determined, proceed on bare `python3` with a loud stderr notice rather than
# silently skipping the check or hard-failing an install with no floor to
# enforce.

_read_requires_python_floor() {
    local pyproject="$1"
    [ -f "$pyproject" ] || return 1
    local line
    line="$(grep -m1 '^requires-python' "$pyproject" || true)"
    [ -n "$line" ] || return 1
    FLOOR="$(printf '%s' "$line" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
    [ -n "$FLOOR" ]
}

# Walk upward from *dir* looking for a pyproject.toml that declares
# requires-python. Sets FLOOR (via _read_requires_python_floor) on success.
#
# The bound is 2 because that is exactly where this launcher's OWN declaration
# sits in a repo checkout: plugins/camp -> plugins -> tools/camp/pyproject.toml.
# It is deliberately not "as far up as it takes to find something". Every extra
# level widens the search into directories the install does not own, where an
# unrelated pyproject.toml decides which interpreter camp accepts — silently
# lowering the floor this check exists to enforce, or raising it until camp
# refuses to run at all. A composed plugin tree legitimately has no declaration
# within reach; that case takes the stated-notice path below, which is the
# honest answer rather than a stranger's number.
_find_requires_python_floor() {
    local dir="$1"
    local levels=0
    local max_levels=2
    while [ "$levels" -le "$max_levels" ]; do
        if _read_requires_python_floor "$dir/pyproject.toml"; then
            return 0
        fi
        [ "$dir" = "/" ] && return 1
        dir="$(dirname "$dir")"
        levels=$((levels + 1))
    done
    return 1
}

_interpreter_version() {
    local interp="$1" out
    out="$("$interp" --version 2>&1)" || return 1
    printf '%s' "$out" | grep -oE '[0-9]+\.[0-9]+' | head -1
}

_version_ge() {
    local c_major="${1%%.*}" c_minor="${1#*.}" f_major="${2%%.*}" f_minor="${2#*.}"
    if [ "$c_major" -gt "$f_major" ]; then return 0; fi
    if [ "$c_major" -lt "$f_major" ]; then return 1; fi
    [ "$c_minor" -ge "$f_minor" ]
}

# Search every `python3` on PATH (PATH order) for one meeting FLOOR. Sets
# CHOSEN_PYTHON on success; sets LAST_FOUND_VERSION regardless, for the error
# message when nothing satisfies. Walks PATH directories directly rather than
# `command -v -a` (a bashism some `command` builtins don't support) so it works
# wherever this script's own `#!/usr/bin/env bash` shebang resolves.
_select_python() {
    local floor="$1"
    CHOSEN_PYTHON=""
    LAST_FOUND_VERSION=""
    local dir interp v
    local saved_ifs="$IFS"
    IFS=':'
    for dir in $PATH; do
        IFS="$saved_ifs"
        [ -n "$dir" ] || continue
        interp="$dir/python3"
        [ -x "$interp" ] || continue
        v="$(_interpreter_version "$interp")" || continue
        LAST_FOUND_VERSION="$v"
        if _version_ge "$v" "$floor"; then
            CHOSEN_PYTHON="$interp"
            return 0
        fi
        IFS=':'
    done
    IFS="$saved_ifs"
    return 1
}

if _find_requires_python_floor "$PLUGIN_DIR"; then
    if _select_python "$FLOOR"; then
        exec "$CHOSEN_PYTHON" "$CLI" "$@"
    else
        echo "camp: requires Python >=${FLOOR}, found Python ${LAST_FOUND_VERSION:-none}" >&2
        exit 1
    fi
else
    echo "camp: could not determine the required Python version (no pyproject.toml declaring requires-python found above $PLUGIN_DIR); proceeding with whatever python3 resolves to" >&2
fi

exec python3 "$CLI" "$@"
