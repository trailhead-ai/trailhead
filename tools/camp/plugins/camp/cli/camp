#!/usr/bin/env python3
"""The `camp` CLI entry point — a thin shim over ``camp.cli.dispatch``.

Puts the plugin root (this file's ``../``) on ``sys.path`` so the sibling
``camp`` package — and the plugin-root-level ``_bootstrap`` module its dispatch
lazy-imports — are importable whether run from the repo or an installed plugin
(``${CLAUDE_PLUGIN_ROOT}/cli/camp``). All command logic lives in ``camp.cli.*``
(one module per command group); keeping this shim minimal keeps that logic
unit-testable and the ``bin/camp`` wrapper's exec target stable.

The inject-route lightness (the hidden ``camp inject --drain`` PostToolUse hook
skips the bootstrap walk and the spine module-load) is handled inside
``dispatch.main`` — importing ``camp.cli.dispatch`` pulls in only the pure-data
verb taxonomy, never spine or trailhead.paths.
"""
from __future__ import annotations

import sys
from pathlib import Path

# cli/camp → parent is cli/ → parent is plugins/camp/ (the plugin root).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from camp.cli import dispatch  # noqa: E402

if __name__ == "__main__":
    sys.exit(dispatch.main())
