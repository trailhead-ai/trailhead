def _cmd_break_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
    dry_run: bool,
) -> None:
    """camp rm [--force] [--name <slug>]"""
    from reconcile import reconcile_break
    from spine import _die
    from manifest import ManifestError

    force = "--force" in args
    filtered = [a for a in args if a != "--force"]
    slug = _slug_from_args_or_cwd(
        filtered, group, verb="rm", consume_positional=True
    )

    if dry_run:
        print(f"[dry-run] would remove worktree {slug!r} for group {group['group']['name']!r}",
              file=sys.stderr)
        return

    try:
        result = reconcile_break(group, slug, env=env, force=force)
    except ManifestError as e:
        _die(f"camp rm: {e}")
    except Exception as e:
        _die(f"camp rm: {e}")

    status = result.get("status", "ok")
    removed = result.get("removed", [])
    print(f"camp rm: removed worktree {slug!r} ({', '.join(removed)})")
    if result.get("errors"):
        print(f"camp rm: errors: {result['errors']}", file=sys.stderr)


def _cmd_restock_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
    dry_run: bool,
) -> None:
    """camp restock — re-run bootstrap commands on each canonical member repo."""
    import json as _json
    import subprocess

    as_json = "--json" in args

    results: dict = {}
    errors = 0

    for member in group["members"]:
        name = member["name"]
        repo_root = Path(member["repo_root"])
        bootstrap = member.get("bootstrap") or []

        if not bootstrap:
            results[name] = {"action": "no-bootstrap"}
            continue

        if dry_run:
            print(f"[dry-run] restock {name}: would run {bootstrap}", file=sys.stderr)
            results[name] = {"action": "dry-run"}
            continue

        r = subprocess.run(
            bootstrap,
            cwd=str(repo_root),
            capture_output=True,
            text=True,
            check=False,
        )
        if r.returncode == 0:
            results[name] = {"action": "ok"}
        else:
            results[name] = {"action": "error", "error": r.stderr.strip()}
            errors += 1

    status = "ok" if errors == 0 else "ok_with_warnings"
    report = {"status": status, "members": results, "errors": errors}

    if as_json:
        print(_json.dumps(report))
    else:
        print(f"camp restock: status={status}")
        for name, info in results.items():
            print(f"  {name}: {info.get('action', '?')}")


def _cmd_rebase_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
    dry_run: bool,
) -> None:
    """camp rebase [--onto <branch>] [--name <slug>]"""
    import subprocess
    from spine import _consume_flag_value, _die
    from manifest import manifest_path_for, read_central_manifest

    filtered = list(args)
    onto = _consume_flag_value(filtered, "--onto") or "origin/main"
    slug = _slug_from_args_or_cwd(filtered, group, verb="rebase")

    group_name = group["group"]["name"]
    mpath = manifest_path_for(group_name, slug, env=env)

    try:
        mdata = read_central_manifest(mpath)
    except Exception as e:
        _die(f"camp rebase: {e}")

    if dry_run:
        print(f"[dry-run] would rebase worktree {slug!r} onto {onto}", file=sys.stderr)
        return

    errors = []
    for m in mdata.get("members", []):
        wt_path = Path(m["worktree_path"])
        if not wt_path.is_dir():
            continue
        r = subprocess.run(
            ["git", "-C", str(wt_path), "rebase", onto],
            capture_output=True,
            text=True,
            check=False,
        )
        if r.returncode != 0:
            errors.append(f"{m['name']}: {r.stderr.strip()}")

    if errors:
        for e in errors:
            print(f"camp rebase: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"camp rebase: {slug!r} rebased onto {onto}")


_GROUP_HELP = """\
usage: camp group <name> [options]

Three modes (every non-default mode requires an explicit flag):

  camp group <name>
      Wire SessionStart hook entries into each member's
      .claude/settings.json for an already-configured group.

  camp group <name> --member NAME=PATH [--member NAME=PATH ...] [options]
      Author a group config TOML from flags (atomic write), then wire hooks.
      Refuses to overwrite an existing config unless --force.

  camp group <name> --scaffold
      Write a commented stub config you edit by hand, then re-run with
      --member. Does not wire hooks.

Options:
  --member NAME=PATH   Repeatable. Add a member (split on the first '=').
  --branch-pattern P   Branch pattern for authored config (default
                       'worktree-{slug}').
  --force              Overwrite an existing config file.
  --allow-missing      Skip the repo_root existence/git check when authoring.
  --scaffold           Write a commented stub config and stop (no hooks).
"""

def _parse_init_args(args: list[str]) -> dict:
    """Parse `camp init` args into {group_name, members, branch_pattern, force,
    allow_missing, scaffold}. Exits non-zero on malformed input."""
    members: list[dict[str, str]] = []
    branch_pattern = "worktree-{slug}"
    force = False
    allow_missing = False
    scaffold = False
    group_name: str | None = None

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--member":
            if i + 1 >= len(args):
                print("camp init: --member requires a NAME=PATH value", file=sys.stderr)
                sys.exit(1)
            members.append(_parse_member(args[i + 1]))
            i += 2
        elif arg.startswith("--member="):
            members.append(_parse_member(arg[len("--member="):]))
            i += 1
        elif arg == "--branch-pattern":
            if i + 1 >= len(args):
                print("camp init: --branch-pattern requires a value", file=sys.stderr)
                sys.exit(1)
            branch_pattern = args[i + 1]
            i += 2
        elif arg.startswith("--branch-pattern="):
            branch_pattern = arg[len("--branch-pattern="):]
            i += 1
        elif arg == "--force":
            force = True
            i += 1
        elif arg == "--allow-missing":
            allow_missing = True
            i += 1
        elif arg == "--scaffold":
            scaffold = True
            i += 1
        elif arg.startswith("-"):
            print(f"camp init: unknown flag {arg!r}", file=sys.stderr)
            sys.exit(1)
        else:
            if group_name is not None:
                print(f"camp init: unexpected argument {arg!r}", file=sys.stderr)
                sys.exit(1)
            group_name = arg
            i += 1

    if group_name is None:
        print("camp init: a group name is required", file=sys.stderr)
        sys.exit(1)

    return {
        "group_name": group_name,
        "members": members,
        "branch_pattern": branch_pattern,
        "force": force,
        "allow_missing": allow_missing,
        "scaffold": scaffold,
    }


def _parse_member(raw: str) -> dict[str, str]:
    """Parse a NAME=PATH member spec, splitting on the FIRST '=' only.

    Rejects empty NAME or empty PATH. Exits non-zero with a legible error.
    """
    if "=" not in raw:
        print(
            f"camp init: malformed --member {raw!r} — expected NAME=PATH",
            file=sys.stderr,
        )
        sys.exit(1)
    name, path = raw.split("=", 1)
    if not name:
        print(
            f"camp init: malformed --member {raw!r} — member NAME must not be empty",
            file=sys.stderr,
        )
        sys.exit(1)
    if not path:
        print(
            f"camp init: malformed --member {raw!r} — member PATH must not be empty",
            file=sys.stderr,
        )
        sys.exit(1)
    return {"name": name, "repo_root": path}


def _cmd_group_cli(args: list[str]) -> None:
    """camp group <name> — wire hooks, author a config from flags, or write a stub."""
    from group_config import load_all_groups, GroupConfigError
    from group_resolve import resolve_group_override, GroupResolutionError
    from init_cmd import run_init
    import group_scaffold
    import trailhead.paths as _paths

    if not args or args[0] in ("--help", "-h"):
        print(_GROUP_HELP)
        return

    parsed = _parse_init_args(args)
    group_name = parsed["group_name"]
    config_dir = _paths.config_dir("camp") / "groups"
    config_path = config_dir / f"{group_name}.toml"

    # --- Mode (c): --scaffold (and no --member) → write a stub, stop ---
    if parsed["scaffold"] and not parsed["members"]:
        if config_path.exists() and not parsed["force"]:
            print(
                f"camp group: config {config_path!s} already exists — pass --force to overwrite",
                file=sys.stderr,
            )
            sys.exit(1)
        config_dir.mkdir(parents=True, exist_ok=True)
        config_path.write_text(group_scaffold.build_stub_toml(group_name))
        print(f"camp group: wrote stub {config_path!s}")
        print(f"  edit this then re-run `camp group {group_name} --member NAME=PATH ...`")
        return

    # --- Mode (a): --member present → author config (atomic) then wire hooks ---
    if parsed["members"]:
        _author_group(
            group_name,
            parsed["members"],
            parsed["branch_pattern"],
            force=parsed["force"],
            allow_missing=parsed["allow_missing"],
            config_dir=config_dir,
            config_path=config_path,
        )
        # Re-load all configs (now including the freshly written one) + wire hooks.
        try:
            all_configs = load_all_groups(config_dir)
            group = resolve_group_override(group_name, all_configs)
            run_init(group, str(_BIN_DIR / "camp"), group_configs=all_configs)
        except (GroupResolutionError, GroupConfigError) as e:
            print(f"camp group: {e}", file=sys.stderr)
            sys.exit(1)
        print(
            f"camp group: authored + wired group {group_name!r} "
            f"({len(group['members'])} member(s))"
        )
        return

    # --- Mode (b): no new flags → unchanged behavior (resolve + wire hooks) ---
    try:
        all_configs = load_all_groups(config_dir)
    except GroupConfigError as e:
        print(f"camp group: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        group = resolve_group_override(group_name, all_configs)
    except GroupResolutionError as e:
        print(f"camp group: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        run_init(group, str(_BIN_DIR / "camp"), group_configs=all_configs)
    except (GroupResolutionError, GroupConfigError) as e:
        print(f"camp group: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"camp group: hooks wired for group {group_name!r} ({len(group['members'])} member(s))")


def _cmd_ai_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
    dry_run: bool,
) -> None:
    """camp ai <slug> — create or resume a workspace.

    Slice 3: synchronous seed (workspace dir + manifest with each member pending)
    then a DETACHED provisioner (camp setup --background) that survives the harness
    launch.

    Slice 6: the launch tail acquires a workspace session lock (refuse-concurrent;
    a live PID holding the lock → refuse, naming workspace + PID + timestamp; a
    stale/dead-PID lock → reclaimed) and dispatches the config-driven harness-launch
    seam. First-ever launch uses the `new` template; an existing workspace uses
    `resume`. The seam os.execvp's the harness (claude default) — tests stub it.
    """
    from spine import _resolve_slug, _consume_flag_value, _die
    from provision import bring_up_workspace
    from manifest import workspace_dir
    import harness_launch
    from session_lock import acquire_session_lock, SessionLockHeld

    rest = list(args)
    _consume_flag_value(rest, "--group")  # already resolved upstream; drop it

    if not rest:
        print("camp ai: a slug is required\n  usage: camp ai <slug>", file=sys.stderr)
        sys.exit(1)

    slug = _resolve_slug(rest[0], context="ai")

    group_name = group["group"]["name"]
    if not group["members"]:
        _die(f"camp ai: group {group_name!r} has no members")

    if dry_run:
        print(
            f"[dry-run] would seed + spawn detached provisioner for {slug!r} "
            f"then launch the harness",
            file=sys.stderr,
        )
        return

    # New-vs-resume is decided BEFORE bring-up creates the workspace dir: a
    # first-ever launch (no workspace) uses the `new` template; an existing
    # workspace uses `resume`.
    ws_dir = workspace_dir(group_name, slug, env=env)
    is_resume = ws_dir.exists()

    # Refuse-concurrent FIRST, before any provisioning: a live PID holding the
    # lock → refuse (naming workspace + PID + timestamp). Stale/dead → reclaimed.
    try:
        acquire_session_lock(ws_dir)
    except SessionLockHeld as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)

    # Resolve the harness profile ONCE for this bring-up; bring_up_workspace and
    # the launch tail both read fields off it (no per-field re-resolution).
    profile = harness_launch.resolve_harness_profile(group)

    try:
        bring_up_workspace(group, slug, env=env, profile=profile)
    except Exception as e:
        _die(f"camp ai: workspace bring-up failed: {e}")

    print(
        f"camp ai: provisioning {slug!r} in the background "
        f"(run 'camp status' / 'camp setup' to track)",
        file=sys.stderr,
    )

    harness_launch.launch(group, slug, ws_dir, is_resume=is_resume, profile=profile)


def _cmd_enter_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
) -> None:
    """camp enter <member> [--name <slug>] — activate a member for the current session.

    Fires the member's activation hooks idempotently, then prints the member's
    CLAUDE.md to stdout so the calling agent ingests it as context.
    """
    from spine import _die
    from activation import enter_member, MemberNotReadyError
    from group_config import GroupConfigError
    from harness_launch import resolve_harness_profile

    filtered = list(args)
    slug = _slug_from_args_or_cwd(filtered, group, verb="enter")

    if not filtered:
        _die("camp enter: a member name is required\n  usage: camp enter <member>")

    member_name = filtered[0]

    profile = resolve_harness_profile(group)

    import subprocess as _subprocess
    try:
        enter_member(group, slug, member_name, env=env, profile=profile)
    except MemberNotReadyError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except GroupConfigError as e:
        print(f"camp enter: {e}", file=sys.stderr)
        sys.exit(1)
    except _subprocess.CalledProcessError as e:
        cmd_str = " ".join(str(t) for t in e.cmd) if isinstance(e.cmd, (list, tuple)) else str(e.cmd)
        print(
            f"camp enter: activation hook failed for member {member_name!r}\n"
            f"  command: {cmd_str}\n"
            f"  exit code: {e.returncode}",
            file=sys.stderr,
        )
        sys.exit(1)
    except ValueError as e:
        _die(f"camp enter: {e}")


def _cmd_cd_group_cli(
    args: list[str],
    group: dict,
    env: dict[str, str] | None,
) -> None:
    """camp cd <slug> — print the resolved workspace path on stdout (exactly one line).

    Security contract: stdout carries ONLY the path; diagnostics go to stderr.
    The shell function wrapping this command cd's to stdout verbatim — any stray
    token on stdout breaks it.
    """
    from spine import _resolve_slug, _consume_flag_value, _die
    from shell_integration import cmd_cd, WorkspaceNotFoundError

    filtered = list(args)
    _consume_flag_value(filtered, "--group")  # already resolved upstream; drop it

    if not filtered:
        print("camp cd: a slug is required\n  usage: camp cd <slug>", file=sys.stderr)
        sys.exit(1)

    slug = _resolve_slug(filtered[0], context="cd")

    try:
        ws_dir = cmd_cd(group, slug, env=env)
    except WorkspaceNotFoundError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)

    # Print the path exactly once, no trailing whitespace, no newline other than
    # the one print() appends.
    print(str(ws_dir))


def _cmd_inject_cli(args: list[str]) -> None:
    """camp inject --drain [--workspace <dir>] — drain the inject queue (hidden).

    The PostToolUse hook handler for the claude-hook inject strategy. Reads the
    workspace inject queue and emits the Claude Code additionalContext JSON, then
    clears the queue; an empty queue emits nothing. The workspace defaults to the
    cwd (the session is rooted at the workspace dir), overridable via --workspace
    (used by tests). Resilient: never crashes a tool call — any error → exit 0.
    """
    from spine import _consume_flag_value

    rest = list(args)
    workspace = _consume_flag_value(rest, "--workspace")
    ws_dir = Path(workspace) if workspace else Path.cwd()

    try:
        from inject import drain_queue
        code = drain_queue(ws_dir)
    except Exception:
        # Never crash a tool call.
        code = 0
    sys.exit(code)


def _cmd_shellenv_cli() -> None:
    """camp shellenv — emit the fish shell integration function on stdout.

    Fish-only: no bash/zsh shim this pass (documented in README + SKILL.md).
    """
    from shell_integration import shellenv

    # Print without a trailing newline beyond what the function text carries,
    # so the output is exactly the function definition.
    print(shellenv(), end="")


def _author_group(
    group_name: str,
    members: list[dict[str, str]],
    branch_pattern: str,
    *,
    force: bool,
    allow_missing: bool,
    config_dir,
    config_path,
) -> None:
    """Validate + atomically write a group config TOML. Exits non-zero on failure."""
    from group_config import load_all_groups, load_group, GroupConfigError
    from group_resolve import GroupConfinementError
    import group_scaffold

    if config_path.exists() and not force:
        print(
            f"camp group: config {config_path!s} already exists — pass --force to overwrite",
            file=sys.stderr,
        )
        sys.exit(1)

    # Load other groups, EXCLUDING the target group by name so a --force redefine
    # does not self-collide against its own prior config in validate_no_overlap.
    try:
        all_configs = load_all_groups(config_dir)
    except GroupConfigError as e:
        print(f"camp group: {e}", file=sys.stderr)
        sys.exit(1)
    other_configs = [c for c in all_configs if c["group"]["name"] != group_name]

    try:
        group_scaffold.validate_scaffold(
            group_name,
            members,
            other_configs=other_configs,
            allow_missing=allow_missing,
        )
    except (group_scaffold.ScaffoldError, GroupConfinementError) as e:
        print(f"camp group: {e}", file=sys.stderr)
        sys.exit(1)

    rendered = group_scaffold.render_group_toml(group_name, members, branch_pattern)

    # Atomic write: tmp → round-trip gate via load_group → os.replace.
    config_dir.mkdir(parents=True, exist_ok=True)
    tmp_path = config_path.with_suffix(config_path.suffix + ".tmp")
    tmp_path.write_text(rendered)
    try:
        load_group(tmp_path)
    except Exception as e:
        tmp_path.unlink(missing_ok=True)
        print(f"camp group: rendered config failed round-trip validation: {e}", file=sys.stderr)
        sys.exit(1)
    os.replace(str(tmp_path), str(config_path))


