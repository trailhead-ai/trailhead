__pycache__/
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
*.pyc
*.log

# This repo is stdlib+pytest only (no uv tooling); agents that mistakenly run
# `uv` regenerate this lockfile, and a stray untracked copy trips
# footprint_guard.py during execute's simplify phase.
uv.lock

.claude

# User/agent-authored install configs live in config/ but must not be committed.
# Only the shipped defaults are tracked.
config/*
!config/default.toml

# Added by code-review-graph
.code-review-graph/

# Local MCP server config — contains machine-specific absolute paths.
.mcp.json
