# direnv environment for trailhead — https://direnv.net
#
# Why this exists: trailhead's bin/* wrappers and plugin shims shell out to
# `python3`. On macOS the system python3 is 3.9 — no `tomllib`, no `X | None`
# — which breaks those subprocesses and the test suite. This file puts a
# project-local 3.11+ interpreter first on PATH, so `python3` resolves to a
# modern interpreter everywhere in the repo (tests AND real bin/* calls), with
# no manual `source .venv/bin/activate`.
#
# Setup (once):
#   - ensure direnv is hooked into your shell — fish: add to ~/.config/fish/config.fish
#         direnv hook fish | source
#   - then run `direnv allow` in this directory to trust this file.
#
# The venv carries only pytest + pytest-xdist (trailhead has zero third-party
# runtime deps).

# Bootstrap .venv the first time, using the newest available 3.11+ interpreter.
if [[ ! -x .venv/bin/python ]]; then
  for _py in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$_py" >/dev/null 2>&1 \
        && "$_py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
      log_status "trailhead: creating .venv with $_py"
      "$_py" -m venv .venv
      .venv/bin/python -m pip install --quiet --upgrade pip pytest pytest-xdist
      break
    fi
  done
fi

# Converge an existing .venv that predates pytest-xdist. A fast import check
# (not an install on every shell entry) keeps this cheap on the common path —
# direnv evaluates this file on every `cd` into the repo.
if [[ -x .venv/bin/python ]] && ! .venv/bin/python -c 'import xdist' >/dev/null 2>&1; then
  log_status "trailhead: installing pytest-xdist into existing .venv"
  .venv/bin/python -m pip install --quiet pytest-xdist
fi

# Put the venv first on PATH so subprocess `python3` resolves to 3.11+.
PATH_add .venv/bin
