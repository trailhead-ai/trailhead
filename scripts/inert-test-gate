#!/usr/bin/env python3
"""inert-test-gate — refuse a test that never executes the thing it tests.

The rule, from the trailhead testing ruleset: *if nothing was executed before the
assertion, it is not a test.* A test whose body only reads files, inspects paths,
matches regexes and shapes data has observed the repo as checked out — it passes
on a codebase where the subject is present and broken, and fails on a correct
rename that changed nothing.

This gate implements exactly that rule and nothing more. For each `test_*`
function it collects every call the body makes, follows one hop into module-local
helpers and same-module fixtures, and reports the function when every one of
those calls is in `INERT_CALLS` — the closed set of operations that observe
rather than execute. An `import` inside the body counts as execution, because
importing the module under test runs it.

The gate carries a second, narrower rule for the near neighbour the first one
misses: a test that *did* run something, but whose subject is a shipped document
and whose assertions only probe it for presence. Such a test constructs no input,
so its output cannot vary — it pins the repo as checked out rather than a
behaviour, goes red on a reword, and passes a meaning-changing edit. A test that
derives a value from a document and checks it against what the code produces is
not this: the document is an input to a computation, and it is left alone.

A third rule is scoped to `tools/craft/tests`. Craft tests reach lore through the in-process
runner, and a test that spawns a real `lore` process belongs in the `seam_real` tier, where CI
runs it as its own job. The gate flags a test, after one hop into module-local helpers, that
calls a subprocess function with an argv list starting with the literal "lore", unless the test
is tier-marked (a module `pytestmark`, a class or test decorator) or sits in a `*_seam.py` file.
It reads the direct form only. A spawn through a PATH shim or `python <lore cli>` looks the same
as a craft script's own spawn, so claiming it would need data-flow analysis and would flag the
deliberate wiring smokes.

Two more rules guard patterns the testing conventions rule out. A class in a craft test file
that answers lore calls with canned replies is the hand-rolled fake the in-process runner
replaced: the gate flags a class named like a lore fake, and a callable class that builds
`CompletedProcess` replies and handles `record` or `vault` arguments. And a test that patches a
spawn function process-wide by its bare name (`patch("subprocess.run")`,
`monkeypatch.setattr(subprocess, "run", ...)`, `patch.object(subprocess, "Popen")`, directly or
through a fixture or helper) is flagged, because that replaces the call for every caller in the
process; the code under test needs a `runner=` seam. Existing sites carry `# inert-gate: allow`,
which a class accepts on its `class` line as a test accepts it on its `def` line.

What it deliberately does NOT do: judge whether an assertion is *about* the right
thing. A test that runs a CLI and then asserts something trivial passes this gate.
The gate catches the mechanical properties that can be checked mechanically.

## Allowing a case

A handful of tests legitimately assert without calling: pinning a closed
vocabulary of caller-visible constants, or guarding a parametrization built at
import time. Mark those with a trailing comment on the `def` line:

    def test_modalities_is_the_closed_vocabulary():  # inert-gate: allow <reason>

The reason is required and is printed by `--list-allowed`, so the exemptions stay
reviewable rather than becoming an invisible backlog.

Usage:
  scripts/inert-test-gate                 # every test_*.py under the repo
  scripts/inert-test-gate <path> [...]    # the given files or directories
  scripts/inert-test-gate --list-allowed  # every current exemption and its reason

Exit: 0 clean · 1 one or more findings (prints relpath:lineno: name).
"""

from __future__ import annotations

import ast
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

#: Operations that observe the tree rather than run its behaviour. A test whose
#: every call is drawn from this set executed nothing. Parsers are deliberately
#: absent — `json.loads` / `tomllib.load` run a real loader, which the ruleset
#: counts as execution ("load the file through its real loader").
INERT_CALLS = frozenset(
    {
        # path construction and filesystem inspection. `Path(...)` is a
        # constructor, not a call into the subject — without it here, every
        # `Path("x").read_text()` reads as execution and the commonest inert
        # form walks straight through the gate.
        "Path", "PurePath", "PosixPath",
        "read_text", "read_bytes", "exists", "is_file", "is_dir", "is_symlink",
        "glob", "rglob", "iterdir", "resolve", "relative_to", "joinpath", "open",
        "stat", "mkdir", "write_text", "write_bytes", "touch", "samefile",
        # reflection — the banned forms in the ruleset
        "hasattr", "getattr", "isinstance", "callable", "dir", "vars", "type",
        "signature", "getmembers", "isclass", "isfunction",
        # text, regex and collection shaping — pure data movement
        "search", "match", "findall", "finditer", "fullmatch", "sub", "split",
        "splitlines", "strip", "lstrip", "rstrip", "lower", "upper", "title",
        "startswith", "endswith", "join", "replace", "count", "index", "format",
        "escape", "compile", "encode", "decode", "removeprefix", "removesuffix",
        "sorted", "set", "len", "list", "dict", "tuple", "frozenset", "str",
        "int", "float", "bool", "any", "all", "add", "append", "extend", "items",
        "keys", "values", "get", "update", "pop", "print", "enumerate", "zip",
        "range", "reversed", "min", "max", "sum", "next", "iter", "repr",
        "difference", "union", "intersection", "issubset", "issuperset",
    }
)

#: Reading a document off the shipped tree. Paired with an assertion that only
#: probes for presence, this is a test whose subject is the repo as checked out.
_DOCUMENT_READS = frozenset({"read_text", "read_bytes", "glob", "rglob", "iterdir"})

#: A fixture that lets a test build its own input. A test taking one of these can
#: vary what it feeds the subject, so the document-probe rule does not apply.
_INPUT_FIXTURES = frozenset({"tmp_path", "tmp_path_factory", "capsys", "monkeypatch"})

#: Calls that ask "is it in there?" without deriving a value to check.
_PROBE_CALLS = frozenset({"search", "match", "findall", "fullmatch", "finditer"})

#: Markers that move a test out of the default run into an opt-in tier.
_TIER_MARKS = ("seam_real", "chromium")

#: Calls that start a process when handed an argv list.
_SPAWN_CALLS = frozenset({"run", "Popen", "check_output", "check_call", "call"})

_LORE_FAKE_NAME_RE = re.compile(r"(Fake|Stub|Mock|Canned)\w*Lore|Lore\w*(Fake|Stub|Mock)")

_ALLOW_RE = re.compile(r"#\s*inert-gate:\s*allow\b[ \t]*(?P<reason>.*)$")


def _repo_anchors(tree: ast.Module) -> set[str]:
    """Module-level names bound to a path expression — the shipped-tree anchors.

    A document probe reads through one of these rather than through a fixture,
    which is what separates "the file this repo ships" from "the file this test
    just wrote".
    """
    out: set[str] = set()
    for node in tree.body:
        if isinstance(node, ast.Assign) and "Path" in ast.dump(node.value):
            out |= {t.id for t in node.targets if isinstance(t, ast.Name)}
    return out


def _call_name(call: ast.Call) -> str | None:
    """The called name: `f` for `f(...)`, `attr` for `x.attr(...)`, else None."""
    return getattr(call.func, "attr", None) or getattr(call.func, "id", None)


def _is_presence_probe(test: ast.expr) -> bool:
    """True if this assertion only asks whether something is present.

    `x in text` and `re.search(p, text)` probe. `parse(text) == rendered()`
    derives a value and checks it, and is not a probe however prose-shaped the
    document it read was.
    """
    if isinstance(test, ast.Compare) and len(test.ops) == 1:
        return isinstance(test.ops[0], (ast.In, ast.NotIn))
    if isinstance(test, ast.Call):
        return _call_name(test) in _PROBE_CALLS
    if isinstance(test, ast.UnaryOp) and isinstance(test.op, ast.Not):
        return _is_presence_probe(test.operand)
    if isinstance(test, ast.BoolOp):
        return all(_is_presence_probe(v) for v in test.values)
    return False


def _executable_names(node: ast.AST) -> set[str]:
    """Every call name and import inside `node`. An import runs the module.

    For a function, only the body is walked. A decorator lives on the function
    node but is not the test running anything — counting `@pytest.mark.parametrize`
    as execution would exempt every parametrized test in the repo.
    """
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
        roots: list[ast.AST] = list(node.body)
    else:
        roots = [node]
    out: set[str] = set()
    for child in (c for root in roots for c in ast.walk(root)):
        if isinstance(child, (ast.Import, ast.ImportFrom)):
            out.add("<import>")
        elif isinstance(child, ast.Call):
            func = child.func
            if isinstance(func, ast.Name):
                out.add(func.id)
            elif isinstance(func, ast.Attribute):
                out.add(func.attr)
    return out


def _is_craft_test_path(path: Path) -> bool:
    parts = path.resolve().parts
    return any(parts[i : i + 3] == ("tools", "craft", "tests") for i in range(len(parts) - 2))


def _is_tier_marked(node: ast.AST) -> bool:
    """True if `node` contains a real `<x>.mark.seam_real` / `<x>.mark.chromium` attribute,
    bare or called. A string that merely names a tier, such as a skip reason, is not a mark."""
    return any(
        isinstance(n, ast.Attribute)
        and n.attr in _TIER_MARKS
        and isinstance(n.value, ast.Attribute)
        and n.value.attr == "mark"
        for n in ast.walk(node)
    )


def _spawns_lore(node: ast.AST) -> bool:
    """True if `node` calls a subprocess function with an argv list starting "lore"."""
    for call in ast.walk(node):
        if not isinstance(call, ast.Call) or not call.args:
            continue
        argv = call.args[0]
        if (
            _call_name(call) in _SPAWN_CALLS
            and isinstance(argv, (ast.List, ast.Tuple))
            and argv.elts
            and isinstance(argv.elts[0], ast.Constant)
            and argv.elts[0].value == "lore"
        ):
            return True
    return False


def _tiered_functions(tree: ast.Module) -> set[int]:
    """ids of test-bearing function nodes a tier mark covers: the whole module through
    `pytestmark`, or an enclosing class or the function's own decorator."""
    module_marked = any(
        isinstance(n, ast.Assign)
        and any(isinstance(t, ast.Name) and t.id == "pytestmark" for t in n.targets)
        and _is_tier_marked(n.value)
        for n in tree.body
    )
    covered: set[int] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and any(_is_tier_marked(d) for d in node.decorator_list):
            covered |= {id(f) for f in ast.walk(node) if isinstance(f, ast.FunctionDef)}
        if isinstance(node, ast.FunctionDef) and (
            module_marked or any(_is_tier_marked(d) for d in node.decorator_list)
        ):
            covered.add(id(node))
    return covered


def _patches_subprocess(node: ast.AST) -> bool:
    """True if `node` patches a spawn function process-wide by its bare name."""
    for call in ast.walk(node):
        if not isinstance(call, ast.Call) or not call.args:
            continue
        if _call_name(call) not in {"patch", "setattr", "object"}:
            continue
        first = call.args[0]
        if isinstance(first, ast.Constant) and isinstance(first.value, str):
            module, _, function = first.value.partition(".")
            if module == "subprocess" and function in _SPAWN_CALLS:
                return True
        elif (
            isinstance(first, ast.Name)
            and first.id == "subprocess"
            and len(call.args) > 1
            and isinstance(call.args[1], ast.Constant)
            and call.args[1].value in _SPAWN_CALLS
        ):
            return True
    return False


def _is_lore_fake_class(node: ast.ClassDef) -> bool:
    if _LORE_FAKE_NAME_RE.search(node.name):
        return True
    callable_ = any(
        isinstance(m, ast.FunctionDef) and m.name == "__call__" for m in node.body
    )
    if not callable_:
        return False
    calls = {_call_name(c) for c in ast.walk(node) if isinstance(c, ast.Call)}
    words = {c.value for c in ast.walk(node) if isinstance(c, ast.Constant) and isinstance(c.value, str)}
    return "CompletedProcess" in calls and bool(words & {"record", "vault"})


def _allow_reason(source_lines: list[str], node: ast.FunctionDef) -> str | None:
    """The reason on an `# inert-gate: allow` comment for this def, if present.

    Read off the `def` line, its decorator lines, and the comment lines
    immediately above them — so a long reason can sit on its own line rather than
    overflowing the `def`.
    """
    first = min([node.lineno] + [d.lineno for d in node.decorator_list])
    while first > 1 and source_lines[first - 2].lstrip().startswith("#"):
        first -= 1
    for lineno in range(first, node.body[0].lineno):
        if match := _ALLOW_RE.search(source_lines[lineno - 1]):
            return match.group("reason").strip() or "(no reason given)"
    return None


def findings_for(path: Path) -> tuple[list[tuple[int, str]], list[tuple[int, str, str]]]:
    """(findings, allowed) for one test module.

    findings: (lineno, test name, verdict) failing a rule and not allowed.
    allowed:  (lineno, test name, reason) carrying an allow marker.
    """
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return [], []

    functions: dict[str, ast.FunctionDef] = {
        node.name: node
        for node in ast.walk(tree)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
    }

    anchors = _repo_anchors(tree)
    craft_test = _is_craft_test_path(path)
    lore_scoped = craft_test and not path.name.endswith("_seam.py")
    tiered = _tiered_functions(tree) if lore_scoped else set()

    findings: list[tuple[int, str, str]] = []
    allowed: list[tuple[int, str, str]] = []
    for node in functions.values():
        if not node.name.startswith("test_"):
            continue
        names = _executable_names(node)
        # One hop into module-local helpers and same-module fixtures: a test that
        # delegates its run to a helper still ran something.
        params = {a.arg for a in node.args.args}
        referenced = (names | params) & set(functions)
        for helper in referenced:
            names |= _executable_names(functions[helper])
        scope = [node, *(functions[h] for h in referenced)]

        if not (names - INERT_CALLS):
            verdict = "executes nothing before asserting"
        elif _probes_a_document(text, node, functions, referenced, params, anchors):
            verdict = "probes a shipped document it never varies"
        elif (
            lore_scoped
            and id(node) not in tiered
            and any(_spawns_lore(f) for f in scope)
        ):
            verdict = "spawns a real lore process outside the seam_real tier"
        elif any(_patches_subprocess(f) for f in scope):
            verdict = "patches a process-wide subprocess function"
        else:
            continue

        if (reason := _allow_reason(lines, node)) is not None:
            allowed.append((node.lineno, node.name, reason))
        else:
            findings.append((node.lineno, node.name, verdict))

    if craft_test:
        for cls in (n for n in ast.walk(tree) if isinstance(n, ast.ClassDef)):
            if not _is_lore_fake_class(cls):
                continue
            if (reason := _allow_reason(lines, cls)) is not None:
                allowed.append((cls.lineno, cls.name, reason))
            else:
                findings.append((cls.lineno, cls.name, "is a hand-rolled lore runner"))
    return findings, allowed


def _probes_a_document(
    text: str,
    node: ast.FunctionDef,
    functions: dict[str, ast.FunctionDef],
    referenced: set[str],
    params: set[str],
    anchors: set[str],
) -> bool:
    """True if this test's whole subject is a document it reads and never varies.

    Three conditions, all required: it builds no input of its own, it reads
    through a shipped-tree anchor, and every assertion it makes only probes for
    presence.
    """
    if params & _INPUT_FIXTURES or not anchors:
        return False
    reads = _executable_names(node)
    for helper in referenced:
        reads |= _executable_names(functions[helper])
    if not (reads & _DOCUMENT_READS):
        return False
    blob = (ast.get_source_segment(text, node) or "") + "".join(
        ast.get_source_segment(text, functions[h]) or "" for h in referenced
    )
    if not any(anchor in blob for anchor in anchors):
        return False
    asserts = [a.test for a in ast.walk(node) if isinstance(a, ast.Assert)]
    return bool(asserts) and all(_is_presence_probe(a) for a in asserts)


def test_modules(paths: list[Path]) -> list[Path]:
    out: set[Path] = set()
    for path in paths:
        if path.is_dir():
            out.update(path.rglob("test_*.py"))
        elif path.name.startswith("test_") and path.suffix == ".py":
            out.add(path)
    return sorted(out)


def main(argv: list[str]) -> int:
    args = argv[1:]
    list_allowed = args[:1] == ["--list-allowed"]
    if list_allowed:
        args = args[1:]

    roots = [Path(a).resolve() for a in args] or [REPO_ROOT]
    modules = test_modules(roots)

    total_findings = 0
    for path in modules:
        findings, allowed = findings_for(path)
        try:
            shown = path.relative_to(REPO_ROOT)
        except ValueError:
            shown = path
        if list_allowed:
            for lineno, name, reason in allowed:
                print(f"{shown}:{lineno}: {name} — {reason}")
            continue
        for lineno, name, verdict in findings:
            print(f"{shown}:{lineno}: {name} {verdict}", file=sys.stderr)
            total_findings += 1

    if list_allowed:
        return 0

    if total_findings:
        print(
            f"\ninert-test-gate: {total_findings} test(s) assert without running their "
            f"subject, assert only that a phrase is present in a document they "
            f"never vary, or (in craft) spawn a real lore outside the seam_real tier or hand-roll a "
            f"lore runner, or patch a subprocess function process-wide. "
            f"Find the consumer and run it, or feed the subject an input "
            f"that changes the answer. A deliberate exemption — a seam smoke, a "
            f"closed vocabulary — is marked `# inert-gate: allow <reason>` on the "
            f"def line.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
